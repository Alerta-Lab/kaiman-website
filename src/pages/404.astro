---
import { ArrowRight, BookOpen, Home, Languages } from 'lucide-react';
import '../styles/global.css';
---

<!doctype html>
<html lang="es" class="h-full">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<meta name="theme-color" content="#6B48E9" />
		<link rel="icon" href="/favicon.ico" />
		<title>Página no encontrada — Kaiman</title>
		<meta name="description" content="Esta dirección no existe en Kaiman. Vuelve al inicio o al blog." />
	</head>
	<body class="min-h-full bg-primary-100 font-sans text-ink antialiased">
		<a
			href="#contenido"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-primary focus:px-3 focus:py-2 focus:text-sm focus:font-bold focus:text-white"
		>
			Saltar al contenido
		</a>

		<main id="contenido" class="mx-auto flex min-h-full max-w-7xl flex-col justify-center px-5 py-16 lg:px-8">
			<div class="max-w-xl animate-[menu-link-in_600ms_var(--ease-brand)_both]">
				<a href="/es/" class="inline-flex items-center gap-3 font-display text-2xl font-bold tracking-tight text-ink">
					<img
						src="/logo.png"
						alt=""
						width="40"
						height="40"
						class="size-10 rounded-lg bg-ink object-contain p-1"
					/>
					<span>Kaiman</span>
				</a>

				<p class="mt-10 font-display text-[clamp(4.5rem,14vw,7rem)] font-bold leading-none tracking-[-0.04em] text-primary">
					404
				</p>

				<h1 class="mt-6 font-display text-3xl font-bold tracking-tight text-balance sm:text-4xl">
					Esta página no está
				</h1>
				<p class="mt-4 max-w-prose text-lg font-medium text-pretty text-ink/75">
					El enlace no corresponde a una sección de Kaiman. Puedes volver al inicio o abrir el blog.
				</p>

				<div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
					<a
						href="/es/"
						class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-primary px-5 font-bold text-white hover:bg-primary-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
					>
						<Home aria-hidden="true" size={18} />
						Inicio
						<span class="font-medium opacity-80">ES</span>
					</a>
					<a
						href="/en/"
						class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-primary-700 bg-white px-5 font-bold text-primary-800 hover:bg-primary-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
					>
						<Languages aria-hidden="true" size={18} />
						Home
						<span class="font-medium opacity-80">EN</span>
					</a>
					<a
						href="/es/blogs"
						class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-primary-200 bg-white px-5 font-bold text-ink hover:bg-primary-100 hover:text-primary-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
					>
						<BookOpen aria-hidden="true" size={18} />
						Blog
						<ArrowRight aria-hidden="true" size={16} />
					</a>
				</div>
			</div>
		</main>
	</body>
</html>

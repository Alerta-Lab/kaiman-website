---
import Headline from '../../../components/blog/atoms/Headline.astro';
import Text from '../../../components/blog/atoms/Text.astro';
import PostCard from '../../../components/blog/molecules/PostCard.astro';
import PublicFooter from '../../../components/blog/organisms/PublicFooter.astro';
import PublicHeader from '../../../components/blog/organisms/PublicHeader.astro';
import { isLocale, locales, type Locale } from '../../../i18n';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { blogIndexPath } from '../../../lib/blog-paths';
import { localeUrl } from '../../../lib/locale-url';
import { listPublishedPosts } from '../../../server/repositories/posts';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const param = Astro.params.locale;
if (!param || !isLocale(param)) return Astro.redirect(localeUrl('es', 'blogs'));
const locale = param as Locale;

const posts = await listPublishedPosts({ limit: 12, locale });
const canonical = new URL(blogIndexPath(locale), Astro.site).toString();
const alternateEs = new URL(blogIndexPath('es'), Astro.site).toString();
const alternateEn = new URL(blogIndexPath('en'), Astro.site).toString();
// The list must reflect publishing changes immediately in each language.
Astro.response.headers.set('Cache-Control', 'no-store');

const copy =
	locale === 'en'
		? {
				title: 'Kaiman Blog — Ideas to create better',
				description: 'Design, technology, and AI to turn ideas into memorable products.',
				headline: 'Design, technology, and AI without the noise.',
				support: 'Concrete lessons for useful experiences, product launches, and working with artificial intelligence.',
				latest: 'Latest articles',
				latestSupport: 'Short, practical reads on product, design, and artificial intelligence.',
				empty: 'No published articles yet.',
			}
		: {
				title: 'Kaiman Blog — Ideas para crear mejor',
				description: 'Diseño, tecnología e inteligencia artificial para convertir ideas en productos memorables.',
				headline: 'Diseño, tecnología e IA sin el ruido.',
				support: 'Aprendizajes concretos para diseñar experiencias útiles, lanzar productos y trabajar con inteligencia artificial.',
				latest: 'Últimos artículos',
				latestSupport: 'Lecturas cortas y aplicables sobre producto, diseño e inteligencia artificial.',
				empty: 'Todavía no hay artículos publicados.',
			};
---

<BlogLayout
	title={copy.title}
	description={copy.description}
	locale={locale}
	canonical={canonical}
	alternateEs={alternateEs}
	alternateEn={alternateEn}
	atmosphere="night"
>
	<PublicHeader locale={locale} />
	<main id="contenido">
		<section class="relative">
			<div class="relative mx-auto flex min-h-[56vh] max-w-7xl items-center px-5 py-24 sm:min-h-[62vh] sm:py-28 lg:px-8 lg:py-36">
				<div class="motion-fade-up max-w-xl lg:max-w-2xl">
					<p class="font-headline text-sm font-bold tracking-[0.14em] text-primary-300 uppercase">Kaiman Blog</p>
					<Headline as="h1" size="6xl" class="mt-4 text-white">
						{copy.headline}
					</Headline>
					<Text size="lg" class="mt-gap-block max-w-[36rem] text-white/75">{copy.support}</Text>
				</div>
			</div>
		</section>

		<section id="articulos" class="relative z-10 -mt-8 px-4 pb-16 sm:-mt-12 sm:px-6 lg:-mt-16 lg:px-8 lg:pb-20">
			<div class="mx-auto max-w-7xl overflow-visible rounded-[1.75rem] bg-white p-6 text-black sm:rounded-[2rem] sm:p-9 lg:rounded-[2.5rem] lg:p-12">
				<div class="mb-gap-page max-w-2xl">
					<Headline as="h2" size="4xl">{copy.latest}</Headline>
					<Text class="mt-gap-control text-black/75">{copy.latestSupport}</Text>
				</div>
				{
					posts.length === 0 ? (
						<p class="rounded-xl bg-primary-100 p-gap-block font-bold text-primary-900">{copy.empty}</p>
					) : (
						<div class="grid gap-gap-block overflow-visible md:grid-cols-2 lg:grid-cols-3 lg:gap-gap-page">
							{posts.map((post) => (
								<PostCard post={post} locale={locale} />
							))}
						</div>
					)
				}
			</div>
		</section>
	</main>
	<PublicFooter locale={locale} />
</BlogLayout>

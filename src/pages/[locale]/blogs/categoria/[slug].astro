---
import Headline from '../../../../components/blog/atoms/Headline.astro';
import Text from '../../../../components/blog/atoms/Text.astro';
import PostCard from '../../../../components/blog/molecules/PostCard.astro';
import PublicFooter from '../../../../components/blog/organisms/PublicFooter.astro';
import PublicHeader from '../../../../components/blog/organisms/PublicHeader.astro';
import { isLocale, locales, type Locale } from '../../../../i18n';
import BlogLayout from '../../../../layouts/BlogLayout.astro';
import { blogCategoryPath, blogTagPath } from '../../../../lib/blog-paths';
import { localeUrl } from '../../../../lib/locale-url';
import {
	categoryDisplayName,
	getCategoryBySlug,
	listPublishedCategories,
	listPublishedPosts,
} from '../../../../server/repositories/posts';

export async function getStaticPaths() {
	const paths: { params: { locale: Locale; slug: string } }[] = [];
	for (const locale of locales) {
		const [posts, categories] = await Promise.all([
			listPublishedPosts({ locale }),
			listPublishedCategories(locale),
		]);
		const slugs = new Set([
			...categories.map((category) => category.slug),
			...posts.flatMap((post) => post.tags.map((tag) => tag.slug)),
		]);
		for (const slug of slugs) {
			paths.push({ params: { locale, slug } });
		}
	}
	return paths;
}

const param = Astro.params.locale;
if (!param || !isLocale(param)) return Astro.redirect(localeUrl('es', 'blogs'));
const locale = param as Locale;
const slug = Astro.params.slug ?? '';

const category = await getCategoryBySlug(slug);
// Before categories existed, tags lived under /categoria/: keep those links working.
if (!category) return Astro.redirect(blogTagPath(locale, slug), 301);

const posts = await listPublishedPosts({ category: slug, locale });
const name = categoryDisplayName(category, locale);
const canonical = new URL(blogCategoryPath(locale, slug), Astro.site).toString();
const alternateEs = new URL(blogCategoryPath('es', slug), Astro.site).toString();
const alternateEn = new URL(blogCategoryPath('en', slug), Astro.site).toString();
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');

const copy =
	locale === 'en'
		? {
				title: `${name} — Kaiman Blog`,
				description: `AI marketing articles for ${name.toLowerCase()} on Kaiman Blog.`,
				support: `AI marketing ideas and guides for ${name.toLowerCase()}.`,
				empty: 'No articles in this category yet.',
			}
		: {
				title: `${name} — Kaiman Blog`,
				description: `Artículos de marketing con IA para ${name.toLowerCase()} en Kaiman Blog.`,
				support: `Ideas y guías de marketing con IA para ${name.toLowerCase()}.`,
				empty: 'Todavía no hay artículos en esta categoría.',
			};
---

<BlogLayout
	title={copy.title}
	description={copy.description}
	locale={locale}
	canonical={canonical}
	alternateEs={alternateEs}
	alternateEn={alternateEn}
>
	<PublicHeader locale={locale} />
	<main id="contenido" class="mx-auto min-h-[70vh] max-w-7xl px-5 py-16 lg:px-8">
		<header class="max-w-2xl border-b border-primary-200 pb-gap-page">
			<Headline as="h1" size="6xl">{name}</Headline>
			<Text class="mt-gap-control text-black/75">{copy.support}</Text>
		</header>
		{
			posts.length === 0 ? (
				<p class="mt-gap-page rounded-xl bg-primary-100 p-gap-block font-bold text-primary-900">{copy.empty}</p>
			) : (
				<div class="mt-gap-page grid gap-gap-block md:grid-cols-2 lg:grid-cols-3 lg:gap-gap-page">
					{posts.map((post) => (
						<PostCard post={post} locale={locale} />
					))}
				</div>
			)
		}
	</main>
	<PublicFooter locale={locale} />
</BlogLayout>

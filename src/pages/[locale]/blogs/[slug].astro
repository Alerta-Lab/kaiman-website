---
import ArticleView from '../../../components/blog/organisms/ArticleView.astro';
import PublicFooter from '../../../components/blog/organisms/PublicFooter.astro';
import PublicHeader from '../../../components/blog/organisms/PublicHeader.astro';
import { isLocale, locales, type Locale } from '../../../i18n';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { blogPostPath } from '../../../lib/blog-paths';
import { getPublishedPost, getSiblingPost, listPublishedPosts } from '../../../server/repositories/posts';

export async function getStaticPaths() {
	const paths: { params: { locale: Locale; slug: string } }[] = [];
	for (const locale of locales) {
		const posts = await listPublishedPosts({ locale });
		for (const post of posts) {
			paths.push({ params: { locale, slug: post.slug } });
		}
	}
	return paths;
}

const param = Astro.params.locale;
if (!param || !isLocale(param)) return Astro.redirect('/es/blogs');
const locale = param as Locale;
const slug = Astro.params.slug ?? '';

const post = await getPublishedPost(slug, locale);
if (!post) return Astro.redirect(`/${locale}/blogs`);

const otherLocale: Locale = locale === 'es' ? 'en' : 'es';
const sibling = await getSiblingPost(post.translationGroupId, otherLocale);
const siblingPublished = sibling?.status === 'published' ? sibling : null;

const canonical = new URL(blogPostPath(locale, post.slug), Astro.site).toString();
const alternateEs =
	locale === 'es'
		? canonical
		: siblingPublished
			? new URL(blogPostPath('es', siblingPublished.slug), Astro.site).toString()
			: null;
const alternateEn =
	locale === 'en'
		? canonical
		: siblingPublished
			? new URL(blogPostPath('en', siblingPublished.slug), Astro.site).toString()
			: null;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.title,
	description: post.seoDescription,
	inLanguage: locale,
	datePublished: post.publishedAt?.toISOString(),
	dateModified: post.updatedAt.toISOString(),
	mainEntityOfPage: canonical,
	image: post.coverUrl || undefined,
	articleSection: post.category ? (locale === 'en' && post.category.nameEn ? post.category.nameEn : post.category.name) : undefined,
	keywords: post.tags.length ? post.tags.map((tag) => (locale === 'en' && tag.nameEn ? tag.nameEn : tag.name)).join(', ') : undefined,
	author: { '@type': 'Organization', name: 'Kaiman Studio' },
};
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');
---

<BlogLayout
	title={post.seoTitle}
	description={post.seoDescription}
	locale={locale}
	image={post.coverUrl}
	canonical={canonical}
	type="article"
	alternateEs={alternateEs}
	alternateEn={alternateEn}
>
	<PublicHeader locale={locale} />
	<main id="contenido" class="bg-white">
		<ArticleView post={post} locale={locale} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</main>
	<PublicFooter locale={locale} />
</BlogLayout>

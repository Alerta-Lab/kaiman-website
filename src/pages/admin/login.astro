---
import { getAdmin } from '../../i18n';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getAdminLocale } from '../../server/admin-locale';

if (Astro.locals.admin) return Astro.redirect('/admin');
const locale = getAdminLocale(Astro.cookies);
const t = getAdmin(locale);
const error = Astro.url.searchParams.has('error');
const needsSetup = Astro.url.searchParams.has('setup');
const reason = Astro.url.searchParams.get('reason');
---

<BlogLayout title={t.login.pageTitle} description={t.login.description} locale={locale} noindex>
	<main id="contenido" class="grid min-h-screen place-items-center bg-primary-100 px-5 py-12">
		<section class="w-full max-w-md rounded-xl border border-primary-200 bg-white p-8">
			<img
				src="/brand/logo.png"
				alt=""
				width="56"
				height="56"
				class="mb-6 size-14 rounded-xl bg-black object-contain p-1.5"
			/>
			<h1 class="font-headline text-3xl font-bold tracking-tight">Kaiman Admin</h1>
			<p class="mt-2 text-black/75">{t.login.intro}</p>
			{
				error && (
					<p role="alert" class="mt-5 rounded-lg bg-error-100 p-3 text-sm font-bold text-error-700">
						{t.login.badCredentials}
					</p>
				)
			}
			{
				needsSetup && (
					<p role="alert" class="mt-5 rounded-lg bg-warning/40 p-3 text-sm font-bold text-black">
						{t.login.setupFailed}
						{reason ? `: ${reason}` : `. ${t.login.setupHint}`}
					</p>
				)
			}
			<form action="/api/auth/login" method="post" class="mt-7 space-y-5">
				<input type="hidden" name="next" value={Astro.url.searchParams.get('next') ?? '/admin'} />
				<div>
					<label for="email" class="mb-2 block font-bold">{t.login.email}</label>
					<input
						id="email"
						name="email"
						type="email"
						autocomplete="username"
						required
						class="min-h-12 w-full rounded-lg border border-black-stroke px-4"
					/>
				</div>
				<div>
					<label for="password" class="mb-2 block font-bold">{t.login.password}</label>
					<input
						id="password"
						name="password"
						type="password"
						autocomplete="current-password"
						required
						minlength="12"
						class="min-h-12 w-full rounded-lg border border-black-stroke px-4"
					/>
				</div>
				<button class="min-h-12 w-full rounded-lg bg-primary px-5 font-bold text-white hover:bg-primary-700">
					{t.login.submit}
				</button>
			</form>
		</section>
	</main>
</BlogLayout>

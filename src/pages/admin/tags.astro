---
import { Plus, Trash2 } from 'lucide-react';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listTags } from '../../server/repositories/posts';

const tags = await listTags();
---

<AdminLayout title="Palabras clave">
	<p class="mb-5 max-w-3xl text-black/75">Las palabras clave describen los temas de cada artículo. Puedes seleccionarlas o crear nuevas desde el editor. Los cambios aquí afectan a todos los artículos que las usan.</p>
	<form action="/api/admin/tags" method="post" class="flex max-w-xl gap-3 rounded-2xl border border-black/10 bg-white p-5">
		<label class="sr-only" for="name">Nueva palabra clave</label>
		<input id="name" name="name" required minlength="2" placeholder="Nueva palabra clave" class="min-h-11 flex-1 rounded-lg border border-black-stroke px-3" />
		<button class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-4 font-bold text-white"><Plus aria-hidden="true" size={18} /> Crear</button>
	</form>
	<ul class="mt-6 grid max-w-3xl gap-3 sm:grid-cols-2">
		{tags.map((tag) => (
			<li class="rounded-xl border border-black/10 bg-white p-4">
				<form action={`/api/admin/tags/${tag.id}`} method="post" class="flex items-center gap-2">
					<input type="hidden" name="_method" value="update" />
					<label class="sr-only" for={`tag-${tag.id}`}>Nombre de {tag.name}</label>
					<input id={`tag-${tag.id}`} name="name" value={tag.name} minlength="2" required class="min-h-11 min-w-0 flex-1 rounded-lg border border-black-stroke px-3" />
					<button class="min-h-11 rounded-lg px-3 font-bold text-primary hover:bg-primary-100">Guardar</button>
				</form>
				<form action={`/api/admin/tags/${tag.id}`} method="post" class="mt-2 flex justify-end">
					<input type="hidden" name="_method" value="delete" />
					<button aria-label={`Eliminar ${tag.name}`} class="rounded-lg p-3 text-error-700 hover:bg-error-100"><Trash2 aria-hidden="true" size={18} /></button>
				</form>
			</li>
		))}
	</ul>
</AdminLayout>

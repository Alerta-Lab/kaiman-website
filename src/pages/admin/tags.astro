---
import { Check, Pencil, Plus, Trash2, X } from 'lucide-react';
import { fillAdmin, getAdmin } from '../../i18n';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminLocale } from '../../server/admin-locale';
import { listTags, tagDisplayName } from '../../server/repositories/posts';

const locale = getAdminLocale(Astro.cookies);
const t = getAdmin(locale);
const tags = await listTags();
const inputClass = 'min-h-11 min-w-0 w-full rounded-lg border border-black-stroke px-3 font-medium';
---

<AdminLayout title={t.tags.title}>
	<p class="mb-5 max-w-3xl text-black/75">{t.tags.description}</p>
	<form action="/api/admin/tags" method="post" class="w-full rounded-2xl border border-black/10 bg-white p-5">
		<div class="grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
			<div>
				<label class="mb-1.5 block text-sm font-bold text-black/70" for="name">{t.tags.spanish}</label>
				<input
					id="name"
					name="name"
					required
					minlength="2"
					placeholder={t.tags.newPlaceholderEs}
					class={inputClass}
				/>
			</div>
			<div>
				<label class="mb-1.5 block text-sm font-bold text-black/70" for="nameEn">{t.tags.english}</label>
				<input
					id="nameEn"
					name="nameEn"
					minlength="2"
					placeholder={t.tags.newPlaceholderEn}
					class={inputClass}
				/>
			</div>
			<button class="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-lg bg-primary px-4 font-bold text-white hover:bg-primary-700">
				<Plus aria-hidden="true" size={18} /> {t.tags.create}
			</button>
		</div>
	</form>

	<ul class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
		{
			tags.map((tag) => {
				const preview = tagDisplayName(tag, locale);
				return (
					<li
						class="rounded-xl border border-black/10 bg-white p-4"
						data-tag-card
						data-name={tag.name}
						data-name-en={tag.nameEn ?? ''}
					>
						<div class="flex items-center gap-2" data-view>
							<p class="min-w-0 flex-1 truncate font-bold text-black" data-label>
								{preview}
							</p>
							<button
								type="button"
								class="inline-flex size-11 shrink-0 items-center justify-center rounded-lg text-primary hover:bg-primary-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
								aria-label={fillAdmin(t.tags.edit, { name: preview })}
								data-edit
							>
								<Pencil aria-hidden="true" size={18} />
							</button>
							<form action={`/api/admin/tags/${tag.id}`} method="post" class="shrink-0">
								<input type="hidden" name="_method" value="delete" />
								<button
									type="submit"
									aria-label={fillAdmin(t.tags.delete, { name: preview })}
									class="inline-flex size-11 items-center justify-center rounded-lg text-error-700 hover:bg-error-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
								>
									<Trash2 aria-hidden="true" size={18} />
								</button>
							</form>
						</div>

						<form
							action={`/api/admin/tags/${tag.id}`}
							method="post"
							class="hidden space-y-3"
							data-edit-panel
						>
							<input type="hidden" name="_method" value="update" />
							<div>
								<label class="mb-1.5 block text-sm font-bold text-black/70" for={`tag-es-${tag.id}`}>
									{t.tags.spanish}
								</label>
								<input
									id={`tag-es-${tag.id}`}
									name="name"
									value={tag.name}
									minlength="2"
									required
									disabled
									class={inputClass}
									data-input-es
								/>
							</div>
							<div>
								<label class="mb-1.5 block text-sm font-bold text-black/70" for={`tag-en-${tag.id}`}>
									{t.tags.english}
								</label>
								<input
									id={`tag-en-${tag.id}`}
									name="nameEn"
									value={tag.nameEn ?? ''}
									minlength="2"
									disabled
									class={inputClass}
									data-input-en
								/>
							</div>
							<div class="flex justify-end gap-2">
								<button
									type="submit"
									class="inline-flex size-11 items-center justify-center rounded-lg text-success-700 hover:bg-success-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
									aria-label={fillAdmin(t.tags.save, { name: preview })}
								>
									<Check aria-hidden="true" size={18} />
								</button>
								<button
									type="button"
									class="inline-flex size-11 items-center justify-center rounded-lg text-black/70 hover:bg-primary-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
									aria-label={fillAdmin(t.tags.cancel, { name: preview })}
									data-cancel
								>
									<X aria-hidden="true" size={18} />
								</button>
							</div>
						</form>
					</li>
				);
			})
		}
	</ul>

	<script>
		const setEditing = (card: HTMLElement, editing: boolean) => {
			const view = card.querySelector<HTMLElement>('[data-view]');
			const panel = card.querySelector<HTMLElement>('[data-edit-panel]');
			const inputEs = card.querySelector<HTMLInputElement>('[data-input-es]');
			const inputEn = card.querySelector<HTMLInputElement>('[data-input-en]');
			if (!view || !panel || !inputEs || !inputEn) return;

			view.classList.toggle('hidden', editing);
			panel.classList.toggle('hidden', !editing);
			inputEs.disabled = !editing;
			inputEn.disabled = !editing;

			if (editing) {
				inputEs.focus();
				inputEs.select();
			} else {
				inputEs.value = card.dataset.name ?? '';
				inputEn.value = card.dataset.nameEn ?? '';
			}
		};

		document.querySelectorAll<HTMLElement>('[data-tag-card]').forEach((card) => {
			card.querySelector('[data-edit]')?.addEventListener('click', () => setEditing(card, true));
			card.querySelector('[data-cancel]')?.addEventListener('click', () => setEditing(card, false));
		});
	</script>
</AdminLayout>

---
import { PostEditor } from '../../../features/posts/PostEditor';
import { getAdmin } from '../../../i18n';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminLocale } from '../../../server/admin-locale';
import { categoryDisplayName, listCategories, listTags } from '../../../server/repositories/posts';

const locale = getAdminLocale(Astro.cookies);
const t = getAdmin(locale);
const categories = await listCategories();
const tags = await listTags();
---

<AdminLayout title={t.editor.newTitle}>
	<PostEditor
		client:load
		mode="create"
		copy={t.editor}
		tagOptions={tags.map(({ id, name, nameEn }) => ({ id, name, nameEn }))}
		activeLocale="es"
		categories={categories.map((category) => ({
			id: category.id,
			name: categoryDisplayName(category, locale),
		}))}
	/>
</AdminLayout>

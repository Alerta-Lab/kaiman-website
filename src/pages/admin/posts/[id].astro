---
import { PostEditor } from '../../../features/posts/PostEditor';
import { getAdmin } from '../../../i18n';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminLocale } from '../../../server/admin-locale';
import {
	categoryDisplayName,
	getPostById,
	getSiblingPost,
	listCategories,
	listTags,
	tagDisplayName,
} from '../../../server/repositories/posts';

const adminLocale = getAdminLocale(Astro.cookies);
const t = getAdmin(adminLocale);
const post = await getPostById(Astro.params.id ?? '');
if (!post) return Astro.redirect('/admin/posts');

const sibling = await getSiblingPost(post.translationGroupId, post.locale === 'es' ? 'en' : 'es');
const categories = await listCategories();
const tags = await listTags();

const toVersion = (item: NonNullable<typeof post>) => ({
	locale: item.locale,
	id: item.id,
	slug: item.slug,
	updatedAt: item.updatedAt.toISOString(),
	title: item.title,
	excerpt: item.excerpt,
	markdown: item.markdown,
	status: item.status,
	seoTitle: item.seoTitle,
	seoDescription: item.seoDescription,
	coverUrl: item.coverUrl ?? '',
	coverAlt: item.coverAlt ?? '',
	tags: item.tags.map((tag) => tagDisplayName(tag, item.locale)).join(', '),
});

const versions = [toVersion(post), ...(sibling ? [toVersion(sibling)] : [])];
---

<AdminLayout title={t.editor.editTitle}>
	<a href={`/admin/posts/${post.id}/editorial`} class="mb-6 inline-flex min-h-11 items-center rounded-lg border border-primary-700 px-4 font-bold text-primary-800">{adminLocale === 'en' ? 'Editorial review and images' : 'Revisión editorial e imágenes'}</a>
	<PostEditor
		client:load
		mode="edit"
		copy={t.editor}
		tagOptions={tags.map(({ id, name, nameEn }) => ({ id, name, nameEn }))}
		activeLocale={post.locale}
		translationGroupId={post.translationGroupId}
		initialSlug={post.slug}
		initialCategoryId={post.categoryId ?? ''}
		initialVersions={versions}
		categories={categories.map((category) => ({
			id: category.id,
			name: categoryDisplayName(category, adminLocale),
		}))}
	/>
</AdminLayout>

---
import { PostEditor } from '../../../features/posts/PostEditor';
import { fillAdmin, getAdmin } from '../../../i18n';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminLocale } from '../../../server/admin-locale';
import {
	categoryDisplayName,
	getPostById,
	getSiblingPost,
	listCategories,
} from '../../../server/repositories/posts';

const locale = getAdminLocale(Astro.cookies);
const t = getAdmin(locale);
const post = await getPostById(Astro.params.id ?? '');
if (!post) return Astro.redirect('/admin/posts');
const sibling = await getSiblingPost(post.translationGroupId, post.locale === 'es' ? 'en' : 'es');
const categories = await listCategories();
---

<AdminLayout title={fillAdmin(t.editor.editTitle, { locale: post.locale.toUpperCase() })}>
	<PostEditor
		client:load
		copy={t.editor}
		categories={categories.map((category) => ({
			id: category.id,
			name: categoryDisplayName(category, locale),
		}))}
		initial={{
			id: post.id,
			updatedAt: post.updatedAt.toISOString(),
			title: post.title,
			slug: post.slug,
			excerpt: post.excerpt,
			markdown: post.markdown,
			status: post.status,
			locale: post.locale,
			seoTitle: post.seoTitle,
			seoDescription: post.seoDescription,
			coverUrl: post.coverUrl,
			coverAlt: post.coverAlt,
			categoryId: post.categoryId,
			hasSibling: Boolean(sibling),
			editorial: post.editorial,
			tags: post.tags.map((tag) => (post.locale === 'en' && tag.nameEn ? tag.nameEn : tag.name)),
		}}
	/>
</AdminLayout>

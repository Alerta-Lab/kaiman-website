---
import { PostEditor } from '../../../features/posts/PostEditor';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getPostById, getSiblingPost, listCategories, listTags } from '../../../server/repositories/posts';

const post = await getPostById(Astro.params.id ?? '');
if (!post) return Astro.redirect('/admin/posts');
const sibling = await getSiblingPost(post.translationGroupId, post.locale === 'es' ? 'en' : 'es');
const categories = await listCategories();
const tags = await listTags();
---

<AdminLayout title={`Editar artículo (${post.locale.toUpperCase()})`}>
	<PostEditor
		client:load
		categories={categories.map(({ id, name }) => ({ id, name }))}
		tagOptions={tags.map(({ id, name, nameEn }) => ({ id, name, nameEn }))}
		initial={{
			id: post.id,
			updatedAt: post.updatedAt.toISOString(),
			title: post.title,
			slug: post.slug,
			excerpt: post.excerpt,
			markdown: post.markdown,
			status: post.status,
			locale: post.locale,
			seoTitle: post.seoTitle,
			seoDescription: post.seoDescription,
			coverUrl: post.coverUrl,
			coverAlt: post.coverAlt,
			categoryId: post.categoryId,
			hasSibling: Boolean(sibling),
			editorial: post.editorial,
			tags: post.tags.map((tag) => (post.locale === 'en' && tag.nameEn ? tag.nameEn : tag.name)),
		}}
	/>
</AdminLayout>

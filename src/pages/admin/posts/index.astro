---
import { Plus } from 'lucide-react';
import Kbd from '../../../components/ui/atoms/Kbd.astro';
import { PostsAdmin, type AdminPostsPayload } from '../../../features/posts/PostsAdmin';
import { getAdmin } from '../../../i18n';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminLocale } from '../../../server/admin-locale';
import { listAllPosts } from '../../../server/repositories/posts';

const locale = getAdminLocale(Astro.cookies);
const t = getAdmin(locale);
const result = await listAllPosts({ page: 1, pageSize: 10 });
const initial: AdminPostsPayload = {
	total: result.total,
	page: result.page,
	pageSize: result.pageSize,
	totalPages: result.totalPages,
	items: result.items.map((post) => ({
		id: post.id,
		title: post.title,
		slug: post.slug,
		locale: post.locale,
		status: post.status,
		updatedAt: post.updatedAt.toISOString(),
		category: post.category
			? {
					id: post.category.id,
					name: post.category.name,
					nameEn: post.category.nameEn,
					slug: post.category.slug,
				}
			: null,
	})),
};
---

<AdminLayout title={t.posts.title}>
	<a
		slot="actions"
		href="/admin/posts/nuevo"
		class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-4 font-bold text-white hover:bg-primary-700"
	>
		<Plus aria-hidden="true" size={18} /> {t.posts.newPost}
		<Kbd tone="onPrimary" label={`${t.shell.shortcut} N`}>N</Kbd>
	</a>
	<PostsAdmin client:load initial={initial} copy={t.posts} locale={locale} />
</AdminLayout>

---
import { Plus, Trash2 } from 'lucide-react';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listCategoriesWithCounts } from '../../server/repositories/posts';

const categories = await listCategoriesWithCounts();
const field = 'min-h-11 min-w-0 flex-1 rounded-lg border border-black-stroke px-3';
---

<AdminLayout title="Categorías">
	<p class="mb-5 max-w-3xl text-black/75">
		La categoría es el sector del negocio al que va dirigido el artículo y se comparte entre sus dos idiomas. La IA elige una de esta lista al guardar un tema del Word y, si ninguna encaja, crea una nueva. Al renombrar se conserva la URL pública.
	</p>
	<form action="/api/admin/categories" method="post" class="flex max-w-3xl flex-wrap gap-3 rounded-2xl border border-black/10 bg-white p-5">
		<label class="sr-only" for="new-name">Nombre en español</label>
		<input id="new-name" name="name" required minlength="2" placeholder="Nombre en español" class={field} />
		<label class="sr-only" for="new-name-en">Nombre en inglés</label>
		<input id="new-name-en" name="nameEn" placeholder="Nombre en inglés" class={field} />
		<button class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-4 font-bold text-white"><Plus aria-hidden="true" size={18} /> Crear</button>
	</form>
	<ul class="mt-6 grid max-w-5xl gap-3 lg:grid-cols-2">
		{categories.map((category) => (
			<li class="rounded-xl border border-black/10 bg-white p-4">
				<form action={`/api/admin/categories/${category.id}`} method="post" class="flex flex-wrap items-center gap-2">
					<input type="hidden" name="_method" value="update" />
					<label class="sr-only" for={`cat-${category.id}`}>Nombre en español de {category.name}</label>
					<input id={`cat-${category.id}`} name="name" value={category.name} minlength="2" required class={field} />
					<label class="sr-only" for={`cat-en-${category.id}`}>Nombre en inglés de {category.name}</label>
					<input id={`cat-en-${category.id}`} name="nameEn" value={category.nameEn ?? ''} placeholder="Nombre en inglés" class={field} />
					<button class="min-h-11 rounded-lg px-3 font-bold text-primary hover:bg-primary-100">Guardar</button>
				</form>
				<div class="mt-2 flex items-center justify-between gap-2">
					<p class="text-sm text-black/65">/{category.slug} · {category.posts} {category.posts === 1 ? 'artículo' : 'artículos'}</p>
					<form action={`/api/admin/categories/${category.id}`} method="post" data-confirm={category.posts ? `Los ${category.posts} artículos de «${category.name}» quedarán sin categoría. ¿Eliminarla?` : `¿Eliminar «${category.name}»?`}>
						<input type="hidden" name="_method" value="delete" />
						<button aria-label={`Eliminar ${category.name}`} class="rounded-lg p-3 text-error-700 hover:bg-error-100"><Trash2 aria-hidden="true" size={18} /></button>
					</form>
				</div>
			</li>
		))}
	</ul>
</AdminLayout>

<script>
	for (const form of document.querySelectorAll<HTMLFormElement>('form[data-confirm]')) {
		form.addEventListener('submit', (event) => {
			if (!confirm(form.dataset.confirm ?? '¿Continuar?')) event.preventDefault();
		});
	}
</script>

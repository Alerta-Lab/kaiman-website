---
import { Check, Pencil, Plus, Trash2, X } from 'lucide-react';
import { fillAdmin, getAdmin } from '../../i18n';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminLocale } from '../../server/admin-locale';
import { categoryDisplayName, listCategoriesWithCounts } from '../../server/repositories/posts';

const locale = getAdminLocale(Astro.cookies);
const t = getAdmin(locale);
const categories = await listCategoriesWithCounts();
const inputClass = 'min-h-11 min-w-0 w-full rounded-lg border border-black-stroke px-3 font-medium';
---

<AdminLayout title={t.categories.title}>
	<form action="/api/admin/categories" method="post" class="w-full rounded-2xl border border-black/10 bg-white p-5">
		<div class="grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
			<div>
				<label class="mb-1.5 block text-sm font-bold text-black/70" for="name">{t.categories.spanish}</label>
				<input
					id="name"
					name="name"
					required
					minlength="2"
					placeholder={t.categories.newPlaceholderEs}
					class={inputClass}
				/>
			</div>
			<div>
				<label class="mb-1.5 block text-sm font-bold text-black/70" for="nameEn">{t.categories.english}</label>
				<input
					id="nameEn"
					name="nameEn"
					minlength="2"
					placeholder={t.categories.newPlaceholderEn}
					class={inputClass}
				/>
			</div>
			<button class="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-lg bg-primary px-4 font-bold text-white hover:bg-primary-700">
				<Plus aria-hidden="true" size={18} /> {t.categories.create}
			</button>
		</div>
	</form>

	<ul class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
		{
			categories.map((category) => {
				const preview = categoryDisplayName(category, locale);
				const postsLabel =
					category.posts === 1
						? t.categories.postsOne
						: fillAdmin(t.categories.postsMany, { count: category.posts });
				return (
					<li
						class="rounded-xl border border-black/10 bg-white p-4"
						data-category-card
						data-name={category.name}
						data-name-en={category.nameEn ?? ''}
					>
						<div class="flex items-center gap-2" data-view>
							<p class="min-w-0 flex-1 truncate font-bold text-black" data-label>
								{preview}
							</p>
							<button
								type="button"
								class="inline-flex size-11 shrink-0 items-center justify-center rounded-lg text-primary hover:bg-primary-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
								aria-label={fillAdmin(t.categories.edit, { name: preview })}
								data-edit
							>
								<Pencil aria-hidden="true" size={18} />
							</button>
							<form
								action={`/api/admin/categories/${category.id}`}
								method="post"
								class="shrink-0"
								data-delete-form
								data-confirm={
									category.posts
										? fillAdmin(t.categories.confirmDeleteWithPosts, {
												count: category.posts,
												name: category.name,
											})
										: fillAdmin(t.categories.confirmDeleteEmpty, { name: category.name })
								}
							>
								<input type="hidden" name="_method" value="delete" />
								<button
									type="submit"
									aria-label={fillAdmin(t.categories.delete, { name: preview })}
									class="inline-flex size-11 items-center justify-center rounded-lg text-error-700 hover:bg-error-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
								>
									<Trash2 aria-hidden="true" size={18} />
								</button>
							</form>
						</div>

						<form
							action={`/api/admin/categories/${category.id}`}
							method="post"
							class="hidden space-y-3"
							data-edit-panel
						>
							<input type="hidden" name="_method" value="update" />
							<div>
								<label class="mb-1.5 block text-sm font-bold text-black/70" for={`cat-es-${category.id}`}>
									{t.categories.spanish}
								</label>
								<input
									id={`cat-es-${category.id}`}
									name="name"
									value={category.name}
									minlength="2"
									required
									disabled
									class={inputClass}
									data-input-es
								/>
							</div>
							<div>
								<label class="mb-1.5 block text-sm font-bold text-black/70" for={`cat-en-${category.id}`}>
									{t.categories.english}
								</label>
								<input
									id={`cat-en-${category.id}`}
									name="nameEn"
									value={category.nameEn ?? ''}
									minlength="2"
									disabled
									class={inputClass}
									data-input-en
								/>
							</div>
							<div class="flex justify-end gap-2">
								<button
									type="submit"
									class="inline-flex size-11 items-center justify-center rounded-lg text-success-700 hover:bg-success-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
									aria-label={fillAdmin(t.categories.save, { name: preview })}
								>
									<Check aria-hidden="true" size={18} />
								</button>
								<button
									type="button"
									class="inline-flex size-11 items-center justify-center rounded-lg text-black/70 hover:bg-primary-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
									aria-label={fillAdmin(t.categories.cancel, { name: preview })}
									data-cancel
								>
									<X aria-hidden="true" size={18} />
								</button>
							</div>
						</form>

						<div class="mt-3 flex items-center justify-between gap-3 border-t border-black/5 pt-3 text-sm font-medium text-black/65">
							<p class="min-w-0 truncate" title={`/${category.slug}`}>
								/{category.slug}
							</p>
							<p class="shrink-0">{postsLabel}</p>
						</div>
					</li>
				);
			})
		}
	</ul>

	<script>
		const setEditing = (card: HTMLElement, editing: boolean) => {
			const view = card.querySelector<HTMLElement>('[data-view]');
			const panel = card.querySelector<HTMLElement>('[data-edit-panel]');
			const inputEs = card.querySelector<HTMLInputElement>('[data-input-es]');
			const inputEn = card.querySelector<HTMLInputElement>('[data-input-en]');
			if (!view || !panel || !inputEs || !inputEn) return;

			view.classList.toggle('hidden', editing);
			panel.classList.toggle('hidden', !editing);
			inputEs.disabled = !editing;
			inputEn.disabled = !editing;

			if (editing) {
				inputEs.focus();
				inputEs.select();
			} else {
				inputEs.value = card.dataset.name ?? '';
				inputEn.value = card.dataset.nameEn ?? '';
			}
		};

		document.querySelectorAll<HTMLElement>('[data-category-card]').forEach((card) => {
			card.querySelector('[data-edit]')?.addEventListener('click', () => setEditing(card, true));
			card.querySelector('[data-cancel]')?.addEventListener('click', () => setEditing(card, false));
		});

		for (const form of document.querySelectorAll<HTMLFormElement>('form[data-confirm]')) {
			form.addEventListener('submit', (event) => {
				if (!confirm(form.dataset.confirm ?? '¿Continuar?')) event.preventDefault();
			});
		}
	</script>
</AdminLayout>

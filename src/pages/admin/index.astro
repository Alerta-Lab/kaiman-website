---
import { FileCheck2, FileClock, FileText, Plus, Tags } from 'lucide-react';
import Kbd from '../../components/ui/atoms/Kbd.astro';
import { getAdmin } from '../../i18n';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminLocale } from '../../server/admin-locale';
import { dashboardCounts } from '../../server/repositories/posts';

const locale = getAdminLocale(Astro.cookies);
const t = getAdmin(locale);
const counts = await dashboardCounts();
const cards = [
	{ label: t.dashboard.cards.posts, value: counts.posts, icon: FileText },
	{ label: t.dashboard.cards.published, value: counts.published, icon: FileCheck2 },
	{ label: t.dashboard.cards.drafts, value: counts.drafts, icon: FileClock },
	{ label: t.dashboard.cards.tags, value: counts.tags, icon: Tags },
];
---

<AdminLayout title={t.dashboard.title}>
	<a
		slot="actions"
		href="/admin/posts/nuevo"
		class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-4 font-bold text-white hover:bg-primary-700"
	>
		<Plus aria-hidden="true" size={19} /> {t.dashboard.newPost}
		<Kbd tone="onPrimary" label={`${t.shell.shortcut} N`}>N</Kbd>
	</a>
	<section aria-label={t.dashboard.sectionAria} class="grid gap-gap-control sm:grid-cols-2 xl:grid-cols-4">
		{
			cards.map(({ label, value, icon: Icon }) => (
				<article class="rounded-xl border border-primary-200 bg-white p-5">
					<Icon aria-hidden="true" className="text-primary" />
					<p class="mt-4 text-sm font-bold text-primary-800">{label}</p>
					<p class="font-headline text-4xl font-bold tracking-tight text-black">{value}</p>
				</article>
			))
		}
	</section>
</AdminLayout>

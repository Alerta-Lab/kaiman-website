---
/**
 * Google tag (gtag.js) for Ads (AW-) + GA4 (G-), and optional Tag Manager (GTM-).
 * Head: scripts. Body: GTM noscript only.
 * @see https://developers.google.com/tag-platform/gtagjs
 */
interface Props {
	placement?: 'head' | 'body';
}

const { placement = 'head' } = Astro.props;

const adsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID?.trim() ?? '';
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() ?? '';
const gtmId = import.meta.env.PUBLIC_GTM_ID?.trim() ?? '';

/** Prefer dedicated Ads ID; allow a lone AW- value in PUBLIC_GA_MEASUREMENT_ID. */
const googleAdsId = /^AW-/i.test(adsId) ? adsId : /^AW-/i.test(gaId) ? gaId : '';
const ga4Id = /^G-/i.test(gaId) ? gaId : '';
const tagManagerId = /^GTM-/i.test(gtmId) ? gtmId : /^GTM-/i.test(gaId) && !ga4Id && !googleAdsId ? gaId : '';

const gtagIds = [googleAdsId, ga4Id].filter(Boolean);
const primaryGtagId = gtagIds[0] ?? '';
const hasGtag = gtagIds.length > 0;
const hasGtm = Boolean(tagManagerId);

const linkerDomains = ['kaimanstudio.ai', 'app.kaimanstudio.ai'] as const;
---

{
	placement === 'head' && hasGtag ? (
		<>
			<script async src={`https://www.googletagmanager.com/gtag/js?id=${primaryGtagId}`}></script>
			<script is:inline define:vars={{ gtagIds, linkerDomains }}>
				window.dataLayer = window.dataLayer || [];
				function gtag() {
					dataLayer.push(arguments);
				}
				gtag('js', new Date());
				for (const id of gtagIds) {
					gtag('config', id, {
						anonymize_ip: true,
						linker: { domains: linkerDomains },
					});
				}
			</script>
		</>
	) : null
}

{
	placement === 'head' && hasGtm ? (
		<script is:inline define:vars={{ tagManagerId }}>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != 'dataLayer' ? '&l=' + l : '';
				j.async = true;
				j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, 'script', 'dataLayer', tagManagerId);
		</script>
	) : null
}

{
	placement === 'body' && hasGtm ? (
		<noscript>
			<iframe
				src={`https://www.googletagmanager.com/ns.html?id=${tagManagerId}`}
				height="0"
				width="0"
				style="display:none;visibility:hidden"
				title="Google Tag Manager"
			></iframe>
		</noscript>
	) : null
}

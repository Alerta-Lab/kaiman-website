---
/**
 * Google tag platform: gtag.js (G- / AW- / …) or Tag Manager (GTM-).
 * Use placement="head" in <head> and placement="body" right after <body>.
 * @see https://developers.google.com/tag-platform/gtagjs
 * @see https://developers.google.com/tag-platform/tag-manager/web
 */
interface Props {
	placement?: 'head' | 'body';
}

const { placement = 'head' } = Astro.props;
const tagId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() ?? '';
const isGtm = /^GTM-[A-Z0-9]+$/i.test(tagId);
const isGtag = Boolean(tagId) && !isGtm;
---

{
	placement === 'head' && isGtag ? (
		<>
			<script async src={`https://www.googletagmanager.com/gtag/js?id=${tagId}`}></script>
			<script is:inline define:vars={{ tagId }}>
				window.dataLayer = window.dataLayer || [];
				function gtag() {
					dataLayer.push(arguments);
				}
				gtag('js', new Date());
				gtag('config', tagId, { anonymize_ip: true });
			</script>
		</>
	) : null
}

{
	placement === 'head' && isGtm ? (
		<script is:inline define:vars={{ tagId }}>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != 'dataLayer' ? '&l=' + l : '';
				j.async = true;
				j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, 'script', 'dataLayer', tagId);
		</script>
	) : null
}

{
	placement === 'body' && isGtm ? (
		<noscript>
			<iframe
				src={`https://www.googletagmanager.com/ns.html?id=${tagId}`}
				height="0"
				width="0"
				style="display:none;visibility:hidden"
				title="Google Tag Manager"
			></iframe>
		</noscript>
	) : null
}

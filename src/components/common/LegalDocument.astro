---
interface Section {
	heading: string;
	paragraphs: string[];
	bullets?: string[];
}

interface Props {
	title: string;
	updated: string;
	intro: string;
	sections: Section[];
	contactHeading: string;
	contactBody: string;
}

const { title, updated, intro, sections, contactHeading, contactBody } = Astro.props;
---

<main id="contenido" class="mx-auto w-full max-w-3xl px-6 pt-28 pb-20 sm:px-10 lg:max-w-4xl lg:px-12 lg:pt-32">
	<p class="text-sm text-neutral-400">{updated}</p>
	<h1 class="mt-3 font-display text-[clamp(1.85rem,4vw,2.75rem)] leading-[1.08] font-semibold tracking-tight text-balance text-white">
		{title}
	</h1>
	<p class="mt-6 text-base leading-relaxed text-pretty text-neutral-300 sm:text-lg">{intro}</p>

	{
		sections.map((section) => (
			<section class="mt-10 border-t border-white/10 pt-8">
				<h2 class="font-display text-xl font-semibold tracking-tight text-white sm:text-2xl">{section.heading}</h2>
				{section.paragraphs.map((paragraph) => (
					<p class="mt-4 text-base leading-relaxed text-pretty text-neutral-300">{paragraph}</p>
				))}
				{section.bullets && section.bullets.length > 0 ? (
					<ul class="mt-4 list-disc space-y-2 pl-5 text-base leading-relaxed text-neutral-300">
						{section.bullets.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				) : null}
			</section>
		))
	}

	<section class="mt-10 border-t border-white/10 pt-8">
		<h2 class="font-display text-xl font-semibold tracking-tight text-white sm:text-2xl">{contactHeading}</h2>
		<p class="mt-4 text-base leading-relaxed text-pretty text-neutral-300">{contactBody}</p>
	</section>
</main>

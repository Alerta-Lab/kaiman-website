	<section id="preguntas" class:list={[sectionY, 'scroll-mt-28', hairline]}>
		<div class="mx-auto w-full max-w-3xl px-5 sm:px-6 lg:px-8">
			<h2 class={h2}>{wf.faq.title}</h2>
			<div class="mt-8" data-faq-list>
				{
					wf.faq.items.map((item, index) => (
						<details class="group border-b border-white/15 open:border-transparent open:bg-white">
							<summary class="cursor-pointer list-none px-5 py-6 marker:content-none sm:px-6 [&::-webkit-details-marker]:hidden">
								<span class="flex items-start gap-4">
									<span class="font-display text-sm font-semibold text-primary-300 tabular-nums transition-colors group-open:text-primary">
										{String(index + 1).padStart(2, '0')}
									</span>
									<span class="font-display text-lg font-semibold text-balance text-white transition-colors group-open:text-ink sm:text-xl">
										{item.q}
									</span>
								</span>
							</summary>
							<div
								data-faq-panel
								class="overflow-hidden transition-[height] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]"
								style="height: 0px"
							>
								<p class="px-5 pb-6 pl-[3.75rem] text-base text-pretty text-neutral-300 group-open:text-ink/80 sm:px-6 sm:pl-16">
									{item.a}
								</p>
							</div>
						</details>
					))
				}
			</div>
		</div>
		<script>
			const list = document.querySelector<HTMLElement>('#preguntas [data-faq-list]');
			if (list) {
				const items = [...list.querySelectorAll<HTMLDetailsElement>('details')];
				const panelOf = (details: HTMLDetailsElement) =>
					details.querySelector<HTMLElement>('[data-faq-panel]');

				const closeItem = (details: HTMLDetailsElement) => {
					const panel = panelOf(details);
					if (!panel || !details.open) return;
					// From `auto` → px → 0 needs a reflow or the collapse skips the transition.
					panel.style.height = `${panel.scrollHeight}px`;
					void panel.offsetHeight;
					panel.style.height = '0px';
					const onEnd = (event: TransitionEvent) => {
						if (event.propertyName !== 'height') return;
						panel.removeEventListener('transitionend', onEnd);
						details.open = false;
					};
					panel.addEventListener('transitionend', onEnd);
				};

				const openItem = (details: HTMLDetailsElement) => {
					items.forEach((other) => {
						if (other !== details) closeItem(other);
					});
					const panel = panelOf(details);
					if (!panel || details.open) return;
					details.open = true;
					panel.style.height = '0px';
					void panel.offsetHeight;
					panel.style.height = `${panel.scrollHeight}px`;
					const onEnd = (event: TransitionEvent) => {
						if (event.propertyName !== 'height') return;
						panel.removeEventListener('transitionend', onEnd);
						panel.style.height = 'auto';
					};
					panel.addEventListener('transitionend', onEnd);
				};

				items.forEach((details) => {
					const summary = details.querySelector('summary');
					if (!summary) return;
					summary.addEventListener('click', (event) => {
						event.preventDefault();
						if (details.open) closeItem(details);
						else openItem(details);
					});
				});
			}
		</script>
	</section>

	{/* Close CTA */}
	<section class:list={['relative py-16 sm:py-20', band]}>
		<div class="relative mx-auto max-w-5xl px-5 text-center sm:px-6">
			<h2 class:list={[h2, 'text-balance']}>{wf.close.title}</h2>
			<p class="mt-4 text-base text-pretty text-neutral-300 sm:text-lg">{wf.close.body}</p>
			<div class="mt-7 flex flex-wrap justify-center gap-3">
				<Button href={signupUrl}>{wf.close.cta}</Button>
			</div>
			<p class="mt-8 font-display text-lg leading-relaxed font-medium text-neutral-300 sm:text-xl">
				{wf.close.noteLines[0]}
				<br />
				{wf.close.noteLines[1]}
				<br />
				<span class="font-semibold text-primary-300">{wf.close.noteAccent}</span>
			</p>
		</div>
	</section>
</main>

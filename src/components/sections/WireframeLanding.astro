---
import {
	BarChart3,
	FileText,
	Globe,
	Image as ImageIcon,
	Presentation,
	Video,
	Volume2,
} from 'lucide-react';
import { getLanding, getWireframe, type Locale } from '../../i18n';
import { blogIndexPath, blogPostPath } from '../../lib/blog-paths';
import { signupUrlForPlan } from '../../lib/plan-handoff';
import {
	alertaUrl,
	creditUnitUsd,
	formatUsd,
	plans,
	signupUrl,
} from '../../lib/plans';
import { asset } from '../../lib/asset';
import { listPublishedPosts } from '../../server/repositories/posts';
import { PlanFinder } from '../plan/PlanFinder';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getLanding(locale);
const wf = getWireframe(locale);
const latestPosts = await listPublishedPosts({ limit: 3, locale });
const blogHref = blogIndexPath(locale);
const demoVideo = asset(locale === 'en' ? '/video/demo-en.mp4' : '/video/demo-es.mp4');
const demoPoster = asset(locale === 'en' ? '/video/demo-en-poster.jpg' : '/video/demo-es-poster.jpg');

const audiencePhotos: Record<string, string> = {
	professionals: asset('/martinez.png'),
	products: asset('/ana.png'),
	sellers: asset('/carlos.png'),
	creators: asset('/sofia.png'),
};

const heroOutputs = [
	asset('/demos/salsana/pieza-2.webp'),
	asset('/brand/showcase-martinez.webp'),
	asset('/demos/salsana/pieza-dulce.webp'),
];

const heroModes = [
	{ id: 'image', label: wf.hero.modes.image, Icon: ImageIcon, active: true },
	{ id: 'analysis', label: wf.hero.modes.analysis, Icon: BarChart3, active: false },
	{ id: 'audio', label: wf.hero.modes.audio, Icon: Volume2, active: false },
	{ id: 'presentation', label: wf.hero.modes.presentation, Icon: Presentation, active: false },
	{ id: 'script', label: wf.hero.modes.script, Icon: FileText, active: false },
	{ id: 'video', label: wf.hero.modes.video, Icon: Video, active: false },
	{ id: 'website', label: wf.hero.modes.website, Icon: Globe, active: false },
] as const;

/** S3 problem facets — drop public/section-3.1.png … section-3.4.png */
const problemFacets = wf.problem.facets.map((facet) => ({
	...facet,
	src: asset(`/${facet.image}.png`),
}));

/** S11 tools blitz — drop public/section-11-1.png … section-11-8.png */
const toolItems = wf.tools.items.map((item) => ({
	...item,
	src: asset(`/${item.image}.png`),
}));

const shell = 'mx-auto w-full max-w-[75rem] px-5 sm:px-6 lg:px-8';
const sectionY = 'py-14 sm:py-16 lg:py-20';
const h2 =
	'font-display text-[clamp(1.65rem,3.4vw,2.75rem)] leading-[1.08] font-semibold tracking-tight text-balance text-white';
const h3 =
	'mt-2 font-display text-[clamp(1.5rem,2.8vw,2.15rem)] leading-[1.1] font-semibold tracking-tight text-balance text-white';
const lead = 'mt-4 max-w-2xl text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base';
const closing = 'mt-6 font-display text-lg leading-snug font-semibold tracking-tight text-white sm:text-xl';
---

<main id="contenido" class="bg-ink text-white">
	{/* S1 · Hero */}
	<section id="top" class="relative overflow-hidden border-b border-white/10">
		<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(1200px_520px_at_80%_0%,rgba(107,72,233,0.28),transparent_70%)]" aria-hidden="true"></div>
		<div class:list={[shell, 'relative grid items-center gap-10 pt-28 pb-14 lg:grid-cols-2 lg:gap-12 lg:pt-32 lg:pb-16']}>
			<div>
				<p class="font-display text-base font-medium text-primary-300 sm:text-lg">{wf.hero.eyebrow}</p>
				<h1 class="mt-3 font-display text-[clamp(2.1rem,5.2vw,3.65rem)] leading-[1.02] font-semibold tracking-tight text-balance text-white">
					{wf.hero.titleBefore}
					<br />
					{wf.hero.titleAfter}{' '}
					<span class="text-primary-300">{wf.hero.titleAccent}</span>
				</h1>
				<p class="mt-5 max-w-xl text-base leading-relaxed text-pretty text-neutral-300 sm:text-lg">{wf.hero.body1}</p>
				<p class="mt-3 max-w-xl text-base leading-relaxed text-pretty text-neutral-300 sm:text-lg">{wf.hero.body2}</p>
				<div class="mt-7 flex flex-wrap gap-3">
					<Button href={signupUrl}>{wf.hero.cta}</Button>
					<Button href="#brand-knowledge" variant="secondary">{wf.hero.secondaryCta}</Button>
				</div>
				<p class="mt-3 text-sm text-neutral-400">{wf.hero.note}</p>
			</div>
			<div class="min-w-0">
				{/* Prompt shell — Wizard-AI style, static / simplified */}
				<div class="overflow-hidden rounded-2xl border-2 border-feature-image bg-ink-200 shadow-2xl shadow-primary/10">
					<div class="flex flex-col gap-3 bg-white/[0.03] p-2.5 sm:p-3">
						<ul
							class="flex w-full flex-nowrap items-center gap-1.5 overflow-hidden"
							aria-label={wf.hero.modesLabel}
						>
							{
								heroModes.map(({ id, label, Icon, active }) => (
									<li class="shrink-0">
										<span
											class:list={[
												'pointer-events-none inline-flex select-none items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium whitespace-nowrap',
												active
													? 'bg-feature-image text-white shadow-sm'
													: 'bg-transparent text-white/55',
											]}
											aria-current={active ? 'true' : undefined}
											data-mode={id}
										>
											<Icon size={14} strokeWidth={2.25} className="shrink-0" aria-hidden="true" />
											{label}
										</span>
									</li>
								))
							}
						</ul>
						<div class="flex flex-col gap-3 rounded-xl border border-white/5 bg-ink p-3 sm:p-4">
							<p class="pointer-events-none select-none text-left text-[0.95rem] leading-relaxed text-neutral-200 sm:text-base">
								{wf.hero.promptText}<span class="ml-0.5 inline-block h-[1.1em] w-px translate-y-[0.1em] bg-primary-300 align-baseline" aria-hidden="true"></span>
							</p>
							<div class="flex flex-wrap items-center gap-2">
								<span class="inline-flex items-center rounded-full border-2 border-black-stroke bg-black-capsule px-4 py-1.5 text-sm font-medium text-white">
									{wf.hero.chipBrand}
								</span>
								<span class="inline-flex items-center rounded-full border-2 border-white bg-white px-4 py-1.5 text-sm font-medium text-ink">
									{wf.hero.chipFormat}
								</span>
							</div>
						</div>
						<div class="grid grid-cols-3 gap-2.5 px-0.5 pb-0.5">
							{
								heroOutputs.map((src) => (
									<div class="aspect-[4/5] overflow-hidden rounded-xl border border-white/10 bg-ink">
										<img
											src={src}
											alt={wf.hero.outputAlt}
											class="h-full w-full object-cover"
											loading="eager"
											decoding="async"
										/>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	{/* S2 · Origin */}
	<section id="origen" class:list={[sectionY, 'border-b border-white/10']}>
		<div class:list={[shell, 'grid items-center gap-8 lg:grid-cols-2 lg:gap-12']}>
			<div>
				<h2 class={h2}>{wf.origin.title}</h2>
				<p class={lead}>{wf.origin.body1}</p>
				<p class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.origin.body2}</p>
				<p class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.origin.body3}</p>
				<p class={closing}>
					{wf.origin.closing}{' '}
					<span class="text-primary-300">{wf.origin.closingAccent}</span>
				</p>
			</div>
			<div class="flex flex-col gap-4">
				<div class="overflow-hidden rounded-2xl border border-white/10 bg-ink-200">
					<img
						src={asset('/section-2.png')}
						alt={wf.origin.imageAlt}
						class="aspect-[16/10] h-auto w-full object-cover"
						loading="lazy"
						decoding="async"
					/>
				</div>
				<p class="text-sm text-neutral-400">
					{wf.origin.clientsLabel}{' '}
					<a href={alertaUrl} class="font-semibold text-primary-300 underline-offset-2 hover:underline">{wf.origin.clientsCta}</a>
				</p>
			</div>
		</div>
	</section>

	{/* S3 · Problem */}
	<section id="problem" class:list={[sectionY, 'border-b border-white/10 bg-ink-100']}>
		<div class={shell}>
			<div class="grid items-end gap-8 lg:grid-cols-2 lg:gap-16">
				<h2 class={h2}>
					{wf.problem.titleBefore}{' '}
					<span class="text-primary-300">{wf.problem.titleAccent}</span>
				</h2>
				<div>
					<p class="text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.problem.body1}</p>
					<p class="mt-3 text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.problem.body2}</p>
				</div>
			</div>
			<ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{
					problemFacets.map((facet) => (
						<li>
							<Card as="div" class="overflow-hidden border border-white/10 p-0 hover:translate-y-0">
								<div class="aspect-video overflow-hidden bg-ink">
									<img
										src={facet.src}
										alt={wf.problem.imageAlt}
										class="h-full w-full object-cover"
										loading="lazy"
										decoding="async"
									/>
								</div>
								<div class="border-t border-white/10 px-4 py-4">
									<p class="font-display text-sm font-semibold tracking-tight text-white sm:text-base">{facet.label}</p>
								</div>
							</Card>
						</li>
					))
				}
			</ul>
			<div class="mt-14 grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
				<p class="font-display text-lg leading-snug font-medium tracking-tight text-pretty text-white sm:text-xl">
					{wf.problem.after}
				</p>
				<div class="rounded-2xl border border-white/10 bg-ink-200 p-8 sm:p-9">
					<p class="font-display text-2xl leading-snug font-semibold tracking-tight text-balance text-white sm:text-3xl">
						{wf.problem.secretBefore}{' '}
						<span class="text-feature-image">{wf.problem.secretAccent}</span>
					</p>
					<p class="mt-4 text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.problem.secretBody1}</p>
					<p class="mt-3 text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.problem.secretBody2}</p>
				</div>
			</div>
		</div>
	</section>

	{/* S4 · Brand Understanding */}
	<section id="brand-knowledge" class:list={[sectionY, 'border-b border-white/10']}>
		<div class={shell}>
			<p class="font-display font-medium text-primary-300">{wf.brandKnowledge.eyebrow}</p>
			<h2 class:list={[h2, 'mt-2 max-w-4xl']}>{wf.brandKnowledge.title}</h2>
			<p class={lead}>{wf.brandKnowledge.body1}</p>
			<p class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.brandKnowledge.body2}</p>
			<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					wf.brandKnowledge.steps.map((step) => (
						<article class="rounded-2xl border border-white/10 bg-ink-200 p-7">
							<p class="font-display text-sm font-semibold tracking-[0.12em] text-primary-300">{step.n}</p>
							<h3 class="mt-1.5 font-display text-xl leading-snug font-semibold text-white sm:text-2xl">{step.title}</h3>
							<p class="mt-2 text-base text-pretty text-neutral-300">{step.body}</p>
						</article>
					))
				}
			</div>
			<div class="mt-14 grid items-center gap-10 lg:grid-cols-2">
				<div>
					<p class="mb-4 text-sm text-neutral-400">{wf.brandKnowledge.learnsLabel}</p>
					<div class="flex flex-wrap gap-2.5">
						{
							wf.brandKnowledge.tags.map((tag) => (
								<span class="rounded-full border border-white/15 bg-ink-200 px-4 py-2.5 text-sm text-neutral-200">{tag}</span>
							))
						}
					</div>
				</div>
				<div class="overflow-hidden rounded-2xl border border-white/10 bg-ink-200">
					<img
						src={asset('/section-4.png')}
						alt={wf.brandKnowledge.resultAlt}
						class="h-auto w-full object-contain object-center"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
		</div>
	</section>

	{/* S5 · Stories intro */}
	<section id="stories" class:list={[sectionY, 'border-b border-white/10 bg-ink-100 pb-10']}>
		<div class={shell}>
			<h2 class:list={[h2, 'max-w-4xl']}>{wf.stories.title}</h2>
			<p class={lead}>{wf.stories.body}</p>
			<div class="mt-11 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{
					wf.stories.personas.map((persona) => (
						<a
							href={persona.href}
							class="group overflow-hidden rounded-2xl border border-white/10 bg-ink-200 text-white transition-colors hover:border-primary/40"
						>
							<div class="aspect-video overflow-hidden">
								<img
									src={audiencePhotos[persona.id]}
									alt=""
									class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
									loading="lazy"
									decoding="async"
								/>
							</div>
							<div class="p-5">
								<p class="text-sm text-primary-300">{persona.who}</p>
								<p class="mt-1 font-display text-lg leading-snug font-semibold tracking-tight text-white sm:text-xl">{persona.job}</p>
								<p class="mt-2 text-sm text-feature-image">{persona.line}</p>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	{/* S6 · Independent professionals */}
	<section id="ana" class:list={[sectionY, 'border-b border-white/10 bg-ink-100 pt-10']}>
		<div class={shell}>
			<div class="rounded-3xl border border-white/10 bg-ink-200 p-6 sm:p-10 lg:p-12">
				<div class="grid items-start gap-10 lg:grid-cols-2">
					<div>
						<p class="text-primary-300">{wf.professionals.eyebrow}</p>
						<h3 class={h3}>{wf.professionals.title}</h3>
						<p class="mt-4 text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.professionals.body}</p>
					</div>
					<div class="overflow-hidden rounded-2xl border border-white/10 bg-ink">
						<img
							src={audiencePhotos.professionals}
							alt={wf.professionals.imageAlt}
							class="aspect-video h-auto w-full object-cover object-top"
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
				<div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
					{
						wf.professionals.steps.map((step) => (
							<article class="rounded-xl border border-white/10 bg-ink p-5">
								<p class="font-display text-xs font-semibold tracking-[0.14em] text-primary-300">{step.n}</p>
								<p class="mt-1 font-display text-lg leading-snug font-semibold text-white">{step.title}</p>
								<p class="mt-2 text-sm text-pretty text-neutral-400">{step.body}</p>
							</article>
						))
					}
				</div>
			</div>
		</div>
	</section>

	{/* S7 · Product creators */}
	<section id="carlos" class:list={[sectionY, 'border-b border-white/10']}>
		<div class={shell}>
			<div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
				<div class="overflow-hidden rounded-2xl border border-white/10 bg-ink-200">
					<img
						src={audiencePhotos.products}
						alt={wf.products.imageAlt}
						class="aspect-video h-auto w-full object-cover object-top"
						loading="lazy"
						decoding="async"
					/>
				</div>
				<div>
					<p class="text-primary-300">{wf.products.eyebrow}</p>
					<h3 class={h3}>{wf.products.title}</h3>
					<p class="mt-4 text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.products.body}</p>
				</div>
			</div>
			<div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
				{
					wf.products.steps.map((step) => (
						<article class="rounded-xl border border-white/10 bg-ink-200 p-5">
							<p class="font-display text-xs font-semibold tracking-[0.14em] text-primary-300">{step.n}</p>
							<p class="mt-1 font-display text-lg leading-snug font-semibold text-white">{step.title}</p>
							<p class="mt-2 text-sm text-pretty text-neutral-400">{step.body}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	{/* S8 · Sellers */}
	<section id="sofia" class:list={[sectionY, 'border-b border-white/10 bg-ink-100']}>
		<div class={shell}>
			<div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
				<div>
					<p class="text-primary-300">{wf.sellers.eyebrow}</p>
					<h3 class={h3}>{wf.sellers.title}</h3>
					<p class="mt-4 text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.sellers.body}</p>
				</div>
				<div class="overflow-hidden rounded-2xl border border-white/10 bg-ink-200">
					<img
						src={audiencePhotos.sellers}
						alt={wf.sellers.imageAlt}
						class="aspect-video h-auto w-full object-cover object-top"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
			<div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
				{
					wf.sellers.steps.map((step) => (
						<article class="rounded-xl border border-white/10 bg-ink-200 p-5">
							<p class="font-display text-xs font-semibold tracking-[0.14em] text-primary-300">{step.n}</p>
							<p class="mt-1 font-display text-lg leading-snug font-semibold text-white">{step.title}</p>
							<p class="mt-2 text-sm text-pretty text-neutral-400">{step.body}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	{/* S8b · Coaches */}
	<section id="coaches" class:list={[sectionY, 'border-b border-white/10 bg-ink-100 pt-4']}>
		<div class={shell}>
			<div class="rounded-3xl border border-white/10 bg-ink-200 p-6 sm:p-10 lg:p-12">
				<div class="grid items-start gap-10 lg:grid-cols-2">
					<div>
						<p class="text-primary-300">{wf.coaches.eyebrow}</p>
						<h3 class={h3}>{wf.coaches.title}</h3>
						<p class="mt-4 text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.coaches.body}</p>
					</div>
					<div class="overflow-hidden rounded-2xl border border-white/10 bg-ink">
						<img
							src={audiencePhotos.creators}
							alt={wf.coaches.imageAlt}
							class="aspect-video h-auto w-full object-cover object-top"
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
				<div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
					{
						wf.coaches.steps.map((step) => (
							<article class="rounded-xl border border-white/10 bg-ink p-5">
								<p class="font-display text-xs font-semibold tracking-[0.14em] text-primary-300">{step.n}</p>
								<p class="mt-1 font-display text-lg leading-snug font-semibold text-white">{step.title}</p>
								<p class="mt-2 text-sm text-pretty text-neutral-400">{step.body}</p>
							</article>
						))
					}
				</div>
			</div>
		</div>
	</section>

	{/* S9 · Tools / blitz */}
	<section id="tools" class:list={[sectionY, 'border-b border-white/10']}>
		<div class={shell}>
			<h2 class:list={[h2, 'max-w-4xl']}>{wf.tools.title}</h2>
			<p class={lead}>{wf.tools.body1}</p>
			<p class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.tools.body2}</p>
			<p class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.tools.body3}</p>
			<div class="mt-11 grid grid-cols-[repeat(auto-fit,minmax(16.25rem,1fr))] gap-4">
				{
					toolItems.map((item) => (
						<article class="overflow-hidden rounded-2xl border border-white/10 bg-ink-200">
							<div class="h-[9.375rem] overflow-hidden border-b border-white/10 bg-ink">
								<img
									src={item.src}
									alt=""
									class="h-full w-full object-cover object-top"
									loading="lazy"
									decoding="async"
								/>
							</div>
							<div class="p-5">
								<p class="font-display text-lg leading-snug font-semibold text-white sm:text-xl">{item.title}</p>
								{item.body ? <p class="mt-2 text-sm text-pretty text-neutral-300 sm:text-[0.95rem]">{item.body}</p> : null}
							</div>
						</article>
					))
				}
			</div>
			<div class="mt-8 flex flex-wrap gap-2.5">
				{
					wf.tools.categories.map((cat) => (
						<span class="rounded-lg border border-white/15 px-3.5 py-2 text-sm text-neutral-300">{cat}</span>
					))
				}
			</div>
		</div>
	</section>

	{/* S9b · Menos / Más */}
	<section id="menos" class:list={[sectionY, 'border-b border-white/10']}>
		<div class={shell}>
			<div class="grid items-end gap-8 lg:grid-cols-2 lg:gap-14">
				<h2 class={h2}>{wf.menos.title}</h2>
				<div>
					<p class="text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.menos.body1}</p>
					<p class="mt-3 text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.menos.body2}</p>
				</div>
			</div>
			<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{
					wf.menos.cards.map((card) => (
						<article class="rounded-2xl border border-white/10 bg-ink-200 p-7">
							<p class="font-display text-xs font-semibold tracking-[0.14em] text-primary-300 uppercase">{card.eyebrow}</p>
							<h3 class="mt-2 font-display text-xl font-semibold text-white sm:text-2xl">{card.title}</h3>
							<p class="mt-3 text-sm text-pretty text-neutral-300 sm:text-base">{card.body}</p>
						</article>
					))
				}
			</div>
			<div class="mt-4 flex flex-wrap items-center gap-4 rounded-2xl bg-primary px-8 py-9 sm:gap-12">
				<div>
					<p class="font-display text-xs font-semibold tracking-[0.14em] text-primary-100 uppercase">{wf.menos.moreEyebrow}</p>
					<p class="mt-1 font-display text-3xl font-semibold text-white sm:text-4xl">{wf.menos.moreTitle}</p>
				</div>
				<p class="max-w-xl text-base text-pretty text-white sm:text-lg">{wf.menos.moreBody}</p>
			</div>
		</div>
	</section>

	{/* Demo anchor */}
	<section id="demo" class:list={[sectionY, 'border-b border-white/10 bg-ink-100']}>
		<div class={shell}>
			<div class="overflow-hidden rounded-2xl border border-white/10 bg-ink">
				<video
					class="aspect-video w-full object-cover"
					poster={demoPoster}
					controls
					playsinline
					preload="metadata"
				>
					<source src={demoVideo} type="video/mp4" />
				</video>
			</div>
		</div>
	</section>

	{/* S10 · Value */}
	<section id="value" class:list={[sectionY, 'border-b border-white/10']}>
		<div class={shell}>
			<h2 class:list={[h2, 'mb-10 max-w-4xl']}>{wf.value.title}</h2>
			<div class="grid gap-4 lg:grid-cols-2">
				<div class="rounded-2xl border border-white/15 p-8 sm:p-9">
					<p class="text-sm text-neutral-400">{wf.value.leftLabel}</p>
					<ul class="mt-5 flex list-disc flex-col gap-2 pl-5 text-neutral-300">
						{wf.value.leftItems.map((item) => <li>{item}</li>)}
					</ul>
					<p class="mt-8 font-display text-4xl font-semibold text-white">
						{wf.value.leftPrice}
						<span class="text-lg font-medium text-neutral-400"> {wf.value.leftPer}</span>
					</p>
					<p class="mt-2 text-sm text-neutral-400">{wf.value.leftNote}</p>
				</div>
				<div class="flex h-full flex-col rounded-2xl bg-primary p-8 text-white sm:p-9">
					<p class="text-sm text-primary-100">{wf.value.rightLabel}</p>
					<p class="mt-4 font-display text-xl leading-snug font-semibold tracking-tight sm:text-2xl">{wf.value.rightTitle}</p>
					<div class="mt-auto pt-8">
						<p class="font-display text-4xl font-semibold">
							{wf.value.rightPrice}
							<span class="text-lg font-medium text-primary-100"> {wf.value.rightPer}</span>
						</p>
						<p class="mt-2 text-sm text-primary-100">{wf.value.rightNote}</p>
					</div>
				</div>
			</div>
			<div
				id="impact"
				class="mt-4 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-white/15 px-6 py-5"
			>
				<p class="font-display text-lg leading-snug font-semibold text-white sm:text-xl">{wf.value.impactTitle}</p>
				<Button href="#piezas" variant="secondary">{wf.value.impactCta}</Button>
			</div>
		</div>
	</section>

	{/* S11 · Pricing */}
	<section id="pricing" class:list={[sectionY, 'border-b border-white/10 bg-ink-100']}>
		<div class={shell}>
			<h2 class={h2}>{copy.plans.title}</h2>
			<p class={lead}>{copy.plans.intro}</p>
			<ul class="mt-11 grid gap-4 md:grid-cols-3">
				{
					plans.map((plan) => (
						<li class="flex flex-col gap-3 rounded-2xl border border-white/10 bg-ink-200 p-7">
							<p class="font-display text-2xl font-semibold text-white">{copy.plans.names[plan.id]}</p>
							<p class="font-display text-4xl font-semibold text-white">
								{formatUsd(plan.monthlyUsd)}
								<span class="text-base font-semibold text-neutral-400"> {copy.plans.perMonth}</span>
							</p>
							<p class="text-sm text-neutral-300">
								{plan.credits.toLocaleString('en-US')} {copy.plans.credits}
							</p>
							<p class="flex-1 text-sm text-neutral-400">{copy.plans.blurbs[plan.id]}</p>
							<p class="text-xs text-neutral-500">
								{formatUsd(creditUnitUsd(plan.monthlyUsd, plan.credits))} {copy.plans.perCredit}
							</p>
							<div class="pt-2">
								<Button href={signupUrlForPlan(plan.id)} plan={plan.id}>{copy.plans.cta}</Button>
							</div>
						</li>
					))
				}
			</ul>
			<div class="mt-4 flex flex-col gap-4 rounded-2xl border border-white/10 bg-ink-200 p-7 sm:flex-row sm:items-center sm:justify-between">
				<div>
					<h3 class="font-display text-2xl font-semibold text-white">{copy.plans.names.enterprise}</h3>
					<p class="mt-2 max-w-2xl text-neutral-300">{copy.plans.blurbs.enterprise}</p>
				</div>
				<Button href={`mailto:${copy.footer.email}`} variant="secondary" plan="enterprise">
					{copy.plans.enterpriseCta}
				</Button>
			</div>
		</div>
	</section>

	{/* Piezas al mes */}
	<section id="piezas" class:list={[sectionY, 'border-b border-white/10']}>
		<div class={shell}>
			<h2 class={h2}>{copy.finder.title}</h2>
			<p class={lead}>{copy.finder.intro}</p>
			<p class="mt-4 max-w-2xl rounded-xl border border-primary/30 bg-primary-900/20 px-4 py-3 text-sm font-semibold text-pretty text-primary-200">
				{copy.finder.disclaimer}
			</p>
			<div class="mt-8">
				<PlanFinder client:visible copy={copy.finder} planNames={copy.plans.names} />
			</div>
		</div>
	</section>

	{/* Playbooks */}
	<section id="playbooks" class:list={[sectionY, 'border-b border-white/10 bg-ink-100']}>
		<div class={shell}>
			<h2 class={h2}>{wf.playbooks.title}</h2>
			<p class={lead}>{wf.playbooks.body}</p>
			<ul class="mt-10 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
				{
					wf.playbooks.items.map((item) => (
						<li>
							<a
								href="#blog"
								class="flex h-full flex-col rounded-2xl border border-white/10 bg-ink-200 p-5 transition-colors hover:border-primary/40"
							>
								<p class="text-sm text-primary-300">{item.industry}</p>
								<p class="mt-2 font-display text-base leading-snug font-semibold text-white sm:text-lg">{item.title}</p>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{/* Blog */}
	<section id="blog" class:list={[sectionY, 'border-b border-white/10']}>
		<div class={shell}>
			<p class="font-display text-sm font-semibold tracking-[0.14em] text-primary-300 uppercase">{copy.blog.eyebrow}</p>
			<h2 class:list={[h2, 'mt-3']}>{copy.blog.title}</h2>
			<p class={lead}>{copy.blog.body}</p>
			{
				latestPosts.length === 0 ? (
					<p class="mt-8 text-neutral-400">{copy.blog.empty}</p>
				) : (
					<ul class="mt-10 grid gap-4 md:grid-cols-3">
						{latestPosts.map((post) => (
							<li>
								<a
									href={blogPostPath(locale, post.slug)}
									class="flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-ink-200 transition-colors hover:border-primary/40"
								>
									{post.coverUrl ? (
										<div class="aspect-[16/10] overflow-hidden bg-ink">
											<img
												src={post.coverUrl}
												alt={post.coverAlt ?? ''}
												class="h-full w-full object-cover"
												loading="lazy"
												decoding="async"
											/>
										</div>
									) : null}
									<div class="flex flex-1 flex-col gap-2 p-5">
										<h3 class="font-display text-lg font-semibold tracking-tight text-white">{post.title}</h3>
										{post.excerpt ? <p class="text-sm text-pretty text-neutral-400">{post.excerpt}</p> : null}
										<span class="mt-auto pt-3 text-sm font-semibold text-primary-300">{copy.blog.read}</span>
									</div>
								</a>
							</li>
						))}
					</ul>
				)
			}
			<div class="mt-8">
				<Button href={blogHref} variant="secondary">{copy.blog.cta}</Button>
			</div>
		</div>
	</section>

	{/* FAQ */}
	<section id="faq" class:list={[sectionY, 'border-b border-white/10']}>
		<div class="mx-auto w-full max-w-3xl px-5 sm:px-6 lg:px-8">
			<h2 class={h2}>{wf.faq.title}</h2>
			<div class="mt-8">
				{
					wf.faq.items.map((item, index) => (
						<details class="group border-b border-white/15 open:border-transparent open:bg-white">
							<summary class="cursor-pointer list-none px-1 py-6 marker:content-none [&::-webkit-details-marker]:hidden">
								<span class="flex items-start gap-4">
									<span class="font-display text-sm font-semibold text-primary-300 tabular-nums">
										{String(index + 1).padStart(2, '0')}
									</span>
									<span class="font-display text-lg font-semibold text-balance text-white transition-colors group-open:text-ink sm:text-xl">
										{item.q}
									</span>
								</span>
							</summary>
							<p class="px-1 pb-6 pl-12 text-base text-pretty text-neutral-300 group-open:text-ink/80">{item.a}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	{/* Close CTA */}
	<section class="relative overflow-hidden py-16 sm:py-20">
		<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(900px_420px_at_50%_100%,rgba(107,72,233,0.28),transparent_72%)]" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-3xl px-5 text-center sm:px-6">
			<h2 class={h2}>{wf.close.title}</h2>
			<p class="mt-4 text-base text-pretty text-neutral-300 sm:text-lg">{wf.close.body}</p>
			<div class="mt-7 flex flex-wrap justify-center gap-3">
				<Button href={signupUrl}>{wf.close.cta}</Button>
			</div>
			<p class="mt-8 font-display text-lg leading-relaxed font-medium text-neutral-300 sm:text-xl">
				{wf.close.noteLines[0]}
				<br />
				{wf.close.noteLines[1]}
				<br />
				<span class="font-semibold text-primary-300">{wf.close.noteAccent}</span>
			</p>
		</div>
	</section>
</main>

---
import fs from 'node:fs';
import path from 'node:path';
import {
	BarChart3,
	Coins,
	FileText,
	Globe,
	HardDrive,
	Image as ImageIcon,
	Presentation,
	Users,
	Video,
	Volume2,
} from 'lucide-react';
import { getLanding, getWireframe, type Locale } from '../../i18n';
import { blogIndexPath, blogPostPath } from '../../lib/blog-paths';
import { signupUrlForPlan } from '../../lib/plan-handoff';
import { formatUsd, plans, signupUrl } from '../../lib/plans';
import { asset } from '../../lib/asset';
import { listPublishedPosts } from '../../server/repositories/posts';
import { PlanFinder } from '../plan/PlanFinder';
import Button from '../ui/Button.astro';
import Tooltip from '../ui/Tooltip.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getLanding(locale);
const wf = getWireframe(locale);
const latestPosts = await listPublishedPosts({ limit: 3, locale });
const blogHref = blogIndexPath(locale);
const demoVideo = asset(locale === 'en' ? '/video/demo-en.mp4' : '/video/demo-es.mp4');
const demoPoster = asset(locale === 'en' ? '/video/demo-en-poster.jpg' : '/video/demo-es-poster.jpg');

const audienceIds = ['martinez', 'ana', 'carlos', 'sofia'] as const;
type AudienceId = (typeof audienceIds)[number];

const resolveAudienceAsset = (folder: 'stories' | 'features', id: AudienceId): string | null => {
	const dir = path.join(process.cwd(), 'public/audiences', folder);
	for (const ext of ['jpg', 'jpeg', 'png', 'webp'] as const) {
		if (fs.existsSync(path.join(dir, `${id}.${ext}`))) {
			return asset(`/audiences/${folder}/${id}.${ext}`);
		}
	}
	return null;
};

/** Stories cards only — never reuse these in detail sections */
const audienceStoryPhotos = Object.fromEntries(
	audienceIds.map((id) => [id, resolveAudienceAsset('stories', id)]),
) as Record<AudienceId, string | null>;

/** Detail sections — drop files in public/audiences/features/{id}.jpg|png */
const audienceFeaturePhotos = Object.fromEntries(
	audienceIds.map((id) => [id, resolveAudienceAsset('features', id)]),
) as Record<AudienceId, string | null>;

const heroOutputs = [
	asset('/hero/output-1.jpg'),
	asset('/hero/output-2.png'),
	asset('/hero/output-3.jpg'),
];

const heroModes = [
	{ id: 'image', label: wf.hero.modes.image, Icon: ImageIcon, active: true },
	{ id: 'analysis', label: wf.hero.modes.analysis, Icon: BarChart3, active: false },
	{ id: 'audio', label: wf.hero.modes.audio, Icon: Volume2, active: false },
	{ id: 'presentation', label: wf.hero.modes.presentation, Icon: Presentation, active: false },
	{ id: 'script', label: wf.hero.modes.script, Icon: FileText, active: false },
	{ id: 'video', label: wf.hero.modes.video, Icon: Video, active: false },
	{ id: 'website', label: wf.hero.modes.website, Icon: Globe, active: false },
] as const;

/** S3 compare — problem/01–03 (sin) · problem/04–06 (con) */
const problemWithout = ['01', '02', '03'].map((n, i) => ({
	src: asset(`/problem/${n}.jpg`),
	alt: `${wf.problem.withoutAlt} ${i + 1}`,
}));
const problemWith = ['04', '05', '06'].map((n, i) => ({
	src: asset(`/problem/${n}.jpg`),
	alt: `${wf.problem.withAlt} ${i + 1}`,
}));
const problemCompare = [
	{ label: wf.problem.withoutLabel, items: problemWithout },
	{ label: wf.problem.withLabel, items: problemWith },
] as const;

/** Tools blitz — public/tools/{n}.png|.jpg */
const toolImageExt: Record<string, 'jpg' | 'png'> = {
	'1': 'jpg',
	'2': 'jpg',
	'5': 'jpg',
	'7': 'jpg',
	'8': 'jpg',
};
const toolItems = wf.tools.items.map((item) => ({
	...item,
	src: asset(`/tools/${item.image}.${toolImageExt[item.image] ?? 'png'}`),
}));

const shell = 'mx-auto w-full max-w-[1600px] px-8 sm:px-12 lg:px-20';
const sectionY = 'relative py-14 sm:py-16 lg:py-20';
const night = 'bg-[#060612]';
/** Solid band — flat navy on selected sections only */
const band = 'bg-[#01001E]';
/** Soft brand glows — bleed across sections (no overflow clip on section). */
const glowTop =
	'pointer-events-none absolute inset-0 bg-[radial-gradient(1100px_520px_at_50%_-8%,rgba(113,73,251,0.22),transparent_72%)]';
const glowBottom =
	'pointer-events-none absolute inset-0 bg-[radial-gradient(900px_420px_at_50%_110%,rgba(113,73,251,0.22),transparent_74%)]';
const glowCenter =
	'pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(67,56,202,0.18),transparent_70%)]';
const glowMist =
	'pointer-events-none absolute inset-0 bg-[radial-gradient(900px_520px_at_100%_0%,rgba(0,207,255,0.06),transparent_58%),radial-gradient(900px_480px_at_0%_100%,rgba(113,73,251,0.16),transparent_62%)]';
const hairline = 'border-b border-white/[0.06]';
const h2 =
	'font-display text-[clamp(1.65rem,3.4vw,2.75rem)] leading-[1.08] font-semibold tracking-tight text-balance text-white';
const h3 =
	'mt-2 font-display text-[clamp(1.5rem,2.8vw,2.15rem)] leading-[1.1] font-semibold tracking-tight text-balance text-white';
const lead = 'mt-4 text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base';
const body = 'mt-3 text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base';
const closing = 'mt-6 font-display text-lg leading-snug font-semibold tracking-tight text-white sm:text-xl';
const gradientH2 =
	'w-fit font-display text-[clamp(1.65rem,3.4vw,2.75rem)] leading-[1.08] font-semibold tracking-tight text-balance bg-[linear-gradient(90deg,#00cfff_0%,#7149fb_100%)] text-gradient';
/** Audience / Brand Understanding section labels — slightly smaller than page H2 */
const gradientLabel =
	'w-fit font-display text-[clamp(1.35rem,2.6vw,2.15rem)] leading-[1.1] font-semibold tracking-tight text-balance bg-[linear-gradient(90deg,#00cfff_0%,#7149fb_100%)] text-gradient';
---

<main id="contenido" class:list={[night, 'relative text-white']}>
	{/* Continuous page atmosphere — avoids hard seams between sections */}
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_90%_35%_at_50%_0%,rgba(113,73,251,0.2),transparent),radial-gradient(ellipse_70%_30%_at_90%_18%,rgba(0,207,255,0.05),transparent),radial-gradient(ellipse_80%_35%_at_10%_38%,rgba(113,73,251,0.14),transparent),radial-gradient(ellipse_85%_40%_at_50%_62%,rgba(67,56,202,0.16),transparent),radial-gradient(ellipse_90%_35%_at_50%_100%,rgba(113,73,251,0.2),transparent)]"
		aria-hidden="true"
	></div>
	{/* S1 · Hero */}
	<section id="hero" class:list={['relative scroll-mt-28', hairline]}>
		<div class={glowMist} aria-hidden="true"></div>
		<div class={glowTop} aria-hidden="true"></div>
		<div class:list={[shell, 'relative grid items-center gap-10 pt-28 pb-14 lg:grid-cols-2 lg:gap-12 lg:pt-32 lg:pb-16']}>
			<div>
				<p class="font-display text-base font-medium text-primary-300 sm:text-lg">{wf.hero.eyebrow}</p>
				<h1 class="mt-3 font-display text-[clamp(2.1rem,5.2vw,3.65rem)] leading-[1.02] font-semibold tracking-tight text-balance text-white">
					{wf.hero.titleBefore}
					<br />
					{wf.hero.titleAfter}{' '}
					<span class="whitespace-nowrap bg-[linear-gradient(90deg,#00cfff_0%,#7149fb_100%)] text-gradient">
						{wf.hero.titleAccent}
					</span>
				</h1>
				<p class="mt-5 max-w-xl text-base leading-relaxed text-pretty text-neutral-300 sm:text-lg">{wf.hero.body1}</p>
				<p class="mt-3 max-w-xl text-base leading-relaxed text-pretty text-neutral-300 sm:text-lg">{wf.hero.body2}</p>
				<div class="mt-7 flex flex-wrap gap-3">
					<Button href={signupUrl}>{wf.hero.cta}</Button>
					<Button href="#brand-understanding" variant="secondary">{wf.hero.secondaryCta}</Button>
				</div>
				<p class="mt-3 text-sm text-neutral-400">{wf.hero.note}</p>
			</div>
			<div class="min-w-0">
				{/* Prompt shell — Wizard-AI style, static / simplified */}
				<div class="overflow-hidden rounded-2xl border-2 border-feature-image bg-ink-200 shadow-2xl shadow-primary/10">
					<div class="flex flex-col gap-3 bg-white/[0.03] p-2.5 sm:p-3">
						<ul
							class="flex w-full flex-nowrap items-center gap-1.5 overflow-hidden"
							aria-label={wf.hero.modesLabel}
						>
							{
								heroModes.map(({ id, label, Icon, active }) => (
									<li class="shrink-0">
										<span
											class:list={[
												'pointer-events-none inline-flex select-none items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium whitespace-nowrap',
												active
													? 'bg-feature-image text-white shadow-sm'
													: 'bg-transparent text-white/55',
											]}
											aria-current={active ? 'true' : undefined}
											data-mode={id}
										>
											<Icon size={14} strokeWidth={2.25} className="shrink-0" aria-hidden="true" />
											{label}
										</span>
									</li>
								))
							}
						</ul>
						<div class="flex flex-col gap-3 rounded-xl border border-white/5 bg-ink p-3 sm:p-4">
							<p class="pointer-events-none select-none text-left text-[0.95rem] leading-relaxed text-neutral-200 sm:text-base">
								{wf.hero.promptText}<span class="ml-0.5 inline-block h-[1.1em] w-px translate-y-[0.1em] bg-primary-300 align-baseline" aria-hidden="true"></span>
							</p>
							<div class="flex flex-wrap items-center gap-2">
								<span class="inline-flex items-center rounded-full border-2 border-black-stroke bg-black-capsule px-4 py-1.5 text-sm font-medium text-white">
									{wf.hero.chipBrand}
								</span>
								<span class="inline-flex items-center rounded-full border-2 border-white bg-white px-4 py-1.5 text-sm font-medium text-ink">
									{wf.hero.chipFormat}
								</span>
							</div>
						</div>
						<div class="grid grid-cols-3 gap-2.5 px-0.5 pb-0.5">
							{
								heroOutputs.map((src) => (
									<div class="aspect-[4/5] overflow-hidden rounded-xl border border-white/10 bg-ink">
										<img
											src={src}
											alt={wf.hero.outputAlt}
											class="h-full w-full object-cover"
											loading="eager"
											decoding="async"
										/>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	{/* S2 · Demo */}
	<section id="demo" class:list={[sectionY, 'scroll-mt-28', 'bg-white']}>
		<div class:list={[shell, 'relative']}>
			<div class="overflow-hidden rounded-2xl border border-black/10 bg-ink">
				<video
					class="aspect-video w-full object-cover"
					poster={demoPoster}
					controls
					autoplay
					muted
					loop
					playsinline
					preload="auto"
				>
					<source src={demoVideo} type="video/mp4" />
				</video>
			</div>
		</div>
	</section>

	{/* S3 · Origin */}
	<section
		id="origen"
		class:list={[
			sectionY,
			'scroll-mt-28',
			'border-b-[10px] border-[#7149FB]',
			'bg-[linear-gradient(180deg,#ffffff_0%,#ffffff_64%,#f7f5ff_78%,#ddd6ff_90%,#a894fc_100%)]',
		]}
	>
		<div class:list={[shell, 'relative grid items-center gap-8 lg:grid-cols-2 lg:gap-12']}>
			<div>
				<h2 class={gradientH2}>{wf.origin.title}</h2>
				<p class="mt-4 text-[0.95rem] leading-relaxed text-pretty text-ink/75 sm:text-base">{wf.origin.body1}</p>
				<p class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-pretty text-ink/75 sm:text-base">{wf.origin.body2}</p>
				<p class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-pretty text-ink/75 sm:text-base">{wf.origin.body3}</p>
				<p class="mt-6 max-w-2xl font-display text-lg leading-snug font-semibold tracking-tight text-pretty text-ink sm:text-xl">
					{wf.origin.closing}{' '}
					<span class="text-primary">{wf.origin.closingAccent}</span>
				</p>
			</div>
			<div class="flex flex-col gap-4">
				<div class="overflow-hidden rounded-2xl border border-black/10 bg-white/40">
					<img
						src={asset('/origin/main.png')}
						alt={wf.origin.imageAlt}
						class="aspect-[16/10] h-auto w-full object-cover"
						loading="lazy"
						decoding="async"
					/>
				</div>
				<p class="text-sm text-pretty text-ink/65">{wf.origin.imageCaption}</p>
			</div>
		</div>
	</section>

	{/* S3 · Brand secret */}
	<section id="secreto" class:list={['relative py-20 sm:py-28 lg:py-32', 'bg-[#18154E]', hairline]}>
		<div class:list={[shell, 'relative']}>
			<div class="mx-auto max-w-3xl text-center">
				<p class={h2}>
					{wf.problem.secretBefore}{' '}
					<span class="text-feature-image">{wf.problem.secretAccent}</span>
				</p>
				<p class="mt-4 text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.problem.secretBody1}</p>
				<p class="mt-3 text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.problem.secretBody2}</p>
			</div>
		</div>
	</section>

	{/* S3b · Problem */}
	<section id="problem" class:list={[sectionY, 'bg-white']}>
		<div class:list={[shell, 'relative']}>
			<div class="grid items-start gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.2fr)] lg:gap-12">
				<div class="min-w-0">
					<h2 class="font-display text-[clamp(1.65rem,3.4vw,2.75rem)] leading-[1.08] font-semibold tracking-tight text-balance text-ink">
						{wf.problem.titleBefore}{' '}
						<span class="bg-[linear-gradient(90deg,#00cfff_0%,#7149fb_100%)] text-gradient">
							{wf.problem.titleAccent}
						</span>
					</h2>
					<p class="mt-6 text-[0.95rem] leading-relaxed text-pretty text-ink/75 sm:text-base">{wf.problem.body1}</p>
					<p class="mt-3 text-[0.95rem] leading-relaxed text-pretty text-ink/75 sm:text-base">{wf.problem.body2}</p>
					<ul class="mt-5 grid grid-cols-2 gap-x-6 gap-y-1.5 text-[0.95rem] leading-relaxed text-ink/75 sm:text-base">
						{
							wf.problem.bullets.map((item) => (
								<li class="flex items-start gap-2">
									<span class="mt-[0.55em] size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
									<span>{item}</span>
								</li>
							))
						}
					</ul>
					<p class="mt-5 text-[0.95rem] leading-relaxed text-pretty text-ink/75 sm:text-base">{wf.problem.after}</p>
				</div>
				<div class="grid min-w-0 grid-cols-2 gap-x-6 gap-y-3 sm:gap-x-8 sm:gap-y-4 lg:h-0 lg:min-h-full lg:gap-x-10">
					{
						problemCompare.map((group) => (
							<figure class="flex min-h-0 min-w-0 flex-col">
								<p class="mb-2 shrink-0 text-center text-sm font-semibold text-ink">{group.label}</p>
								<div class="flex min-h-0 flex-1 flex-col gap-2 sm:gap-2.5">
									{group.items.map((item) => (
										<div class="flex w-full items-center justify-center overflow-hidden rounded-xl max-lg:aspect-[43/24] lg:min-h-0 lg:flex-1">
											<img
												src={item.src}
												alt={item.alt}
												width="1600"
												height="893"
												class="max-h-full max-w-full object-contain"
												loading="lazy"
												decoding="async"
											/>
										</div>
									))}
								</div>
							</figure>
						))
					}
				</div>
			</div>
		</div>
	</section>

	{/* S4 · Brand Understanding */}
	<section id="brand-understanding" class:list={[sectionY, 'scroll-mt-28', band, hairline]}>
		<div class:list={[shell, 'relative']}>
			<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
				<div>
					<h2 class={gradientLabel}>{wf.brandKnowledge.eyebrow}</h2>
					<h3 class={h3}>{wf.brandKnowledge.title}</h3>
					<p class={lead}>{wf.brandKnowledge.body1}</p>
					<p class={body}>{wf.brandKnowledge.body2}</p>
				</div>
				<div class="overflow-hidden rounded-2xl border border-white/10 bg-ink-200">
					<img
						src={asset('/brand-understanding/main.png')}
						alt={wf.brandKnowledge.resultAlt}
						class="h-auto w-full object-contain object-center"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
			<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					wf.brandKnowledge.steps.map((step) => (
						<article class="rounded-2xl border border-white/10 bg-ink-200 p-7 max-lg:last:odd:col-span-full">
							<p class="font-display text-sm font-semibold tracking-[0.12em] text-primary-300">{step.n}</p>
							<h3 class="mt-1.5 font-display text-xl leading-snug font-semibold text-white sm:text-2xl">{step.title}</h3>
							<p class="mt-2 text-base text-pretty text-neutral-300">{step.body}</p>
						</article>
					))
				}
			</div>
			<div class="mt-14 flex flex-col items-center text-center">
				<p class="mb-5 font-display text-2xl font-semibold tracking-tight text-white sm:text-3xl">{wf.brandKnowledge.learnsLabel}</p>
				<div class="flex max-w-3xl flex-wrap justify-center gap-2.5">
					{
						wf.brandKnowledge.tags.map((tag) => (
							<span class="rounded-full border border-white/15 bg-ink-200 px-4 py-2.5 text-sm text-neutral-200">{tag}</span>
						))
					}
				</div>
			</div>
		</div>
	</section>

	{/* S5 · Stories intro */}
	<section id="stories" class:list={[sectionY, 'bg-white', 'pb-10']}>
		<div class:list={[shell, 'relative']}>
			<div class="mx-auto max-w-4xl text-center">
				<h2 class:list={[gradientH2, 'mx-auto']}>{wf.stories.title}</h2>
				<p class="mt-5 text-[0.95rem] leading-relaxed text-pretty text-ink/75 sm:text-base">{wf.stories.body}</p>
			</div>
			<div class="mt-11 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{
					wf.stories.personas.map((persona) => (
						<a
							href={persona.href}
							class="group flex h-full flex-col overflow-hidden rounded-2xl bg-[#18154E] text-white transition-colors hover:brightness-110"
						>
							<div class="aspect-[4/3] overflow-hidden bg-[#18154E]">
								{
									audienceStoryPhotos[persona.id as AudienceId] ? (
										<img
											src={audienceStoryPhotos[persona.id as AudienceId]!}
											alt=""
											class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
											loading="lazy"
											decoding="async"
										/>
									) : null
								}
							</div>
							<div class="flex flex-1 flex-col p-5 sm:p-6">
								<p class="font-display text-lg leading-snug font-semibold tracking-tight text-white sm:text-xl">{persona.who}</p>
								<p class="mt-2 text-sm leading-relaxed text-white">{persona.job}</p>
								<p class="mt-1 inline-flex items-center gap-2 text-sm leading-relaxed text-white">
									<span aria-hidden="true">•</span>
									{persona.line}
								</p>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	{/* S6 · Martinez · Independent professionals */}
	<section id="martinez" class:list={[sectionY, 'bg-[#01001E]', hairline, 'pt-10']}>
		<div class:list={[shell, 'relative']}>
			<div class="grid items-start gap-10 lg:grid-cols-2">
				<div>
					<h2 class={gradientLabel}>{wf.professionals.eyebrow}</h2>
					<h3 class={h3}>{wf.professionals.title}</h3>
					<p class="mt-4 text-[0.95rem] leading-relaxed text-pretty text-neutral-300 sm:text-base">{wf.professionals.body}</p>
				</div>
				<div class="overflow-hidden rounded-2xl border border-white/10 bg-[#01001E]">
					{
						audienceFeaturePhotos.martinez ? (
							<img
								src={audienceFeaturePhotos.martinez}
								alt={wf.professionals.imageAlt}
								class="aspect-video h-auto w-full object-cover object-top"
								loading="lazy"
								decoding="async"
							/>
						) : (
							<div class="aspect-video w-full bg-[#01001E]" aria-hidden="true"></div>
						)
					}
				</div>
			</div>
			<div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
				{
					wf.professionals.steps.map((step) => (
						<article class="rounded-xl border border-white/10 bg-black p-5 max-lg:last:odd:col-span-full">
							<p class="font-display text-xs font-semibold tracking-[0.14em] text-primary-300">{step.n}</p>
							<p class="mt-1 font-display text-lg leading-snug font-semibold text-white">{step.title}</p>
							<p class="mt-2 text-sm text-pretty text-neutral-400">{step.body}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	{/* S7 · Ana · Product creators */}
	<section id="ana" class:list={[sectionY, 'bg-white']}>
		<div class:list={[shell, 'relative']}>
			<div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
				<div class="overflow-hidden rounded-2xl border border-black/10 bg-white">
					{
						audienceFeaturePhotos.ana ? (
							<img
								src={audienceFeaturePhotos.ana}

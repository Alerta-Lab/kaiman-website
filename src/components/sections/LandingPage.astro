---
import {
	ArrowUpRight,
	Coins,
	Folder,
	HardDrive,
	Users,
} from 'lucide-react';
import { getLanding, type Locale } from '../../i18n';
import { blogIndexPath, blogPostPath } from '../../lib/blog-paths';
import { signupUrlForPlan } from '../../lib/plan-handoff';
import {
	alertaUrl,
	creditUnitUsd,
	formatUsd,
	plans,
	signupUrl,
} from '../../lib/plans';
import { asset } from '../../lib/asset';
import { listPublishedPosts } from '../../server/repositories/posts';
import { PieceGallery } from '../gallery/PieceGallery';
import { PlanFinder } from '../plan/PlanFinder';
import Button from '../ui/Button.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getLanding(locale);
const latestPosts = await listPublishedPosts({ limit: 3, locale });
const blogHref = blogIndexPath(locale);
const demoPoster = asset(locale === 'en' ? '/video/demo-en-poster.jpg' : '/video/demo-es-poster.jpg');
const demoVideo = asset(locale === 'en' ? '/video/demo-en.mp4' : '/video/demo-es.mp4');

const gutter = 'px-5 sm:px-8 lg:px-10';
const panel =
	`relative flex min-h-svh w-full flex-col justify-center overflow-hidden border-t border-white/10 bg-ink-100 ${gutter} pt-24 pb-10`;
const body = 'text-sm text-pretty text-neutral-200 sm:text-base';
const card = 'rounded-xl bg-ink-200 p-4 sm:p-5';
/** Horizontal snap carousel below lg; grid/stack from lg up. */
const mobileCarousel =
	'flex snap-x snap-mandatory gap-3 overflow-x-auto pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden lg:grid lg:snap-none lg:gap-0 lg:overflow-visible';
const mobileSlide = 'w-[min(18.5rem,82vw)] shrink-0 snap-start lg:w-auto lg:shrink';

const chapters = [
	{ id: 'hero', label: locale === 'en' ? 'Start' : 'Inicio' },
	{ id: 'demo', label: 'Demo' },
	{ id: 'origen', label: locale === 'en' ? 'Origin' : 'Origen' },
	{ id: 'producto', label: copy.nav.product },
	{ id: 'brand-understanding', label: copy.nav.brand },
	{ id: 'audiencias', label: locale === 'en' ? 'Audience' : 'Audiencias' },
	{ id: 'plataforma', label: locale === 'en' ? 'Platform' : 'Plataforma' },
	{ id: 'planes', label: copy.nav.plans },
	{ id: 'preguntas', label: locale === 'en' ? 'FAQ' : 'FAQ' },
];

const audiencePhotos: Record<string, string> = {
	professionals: asset('/audiences/martinez.png'),
	products: asset('/audiences/ana.png'),
	sellers: asset('/audiences/carlos.png'),
	creators: asset('/audiences/sofia.png'),
};

const tourMedia = [
	asset('/hero/output-1.jpg'),
	asset('/hero/output-2.png'),
	asset('/hero/output-3.jpg'),
] as const;

const origenLead = copy.origin.paragraphs[0] ?? '';
const origenRest = copy.origin.paragraphs.slice(1);
const origenChapterLabel = locale === 'en' ? 'Origin' : 'Origen';
---

<div data-landing-curtain="top" class="pointer-events-none fixed inset-x-0 top-0 z-[100] h-[50vh] bg-ink" aria-hidden="true"></div>
<div data-landing-curtain="bottom" class="pointer-events-none fixed inset-x-0 bottom-0 z-[100] h-[50vh] bg-ink" aria-hidden="true"></div>

<nav
	data-chapter-rail
	class="pointer-events-none fixed top-1/2 right-4 z-50 hidden -translate-y-1/2 flex-col gap-3 lg:pointer-events-auto lg:flex"
	aria-label={locale === 'en' ? 'Sections' : 'Secciones'}
>
	{
		chapters.map((chapter, index) => (
			<button
				type="button"
				data-chapter-rail-item={chapter.id}
				class="group flex items-center justify-end gap-3 text-right opacity-45 transition-opacity duration-300 hover:opacity-100 aria-[current=true]:opacity-100"
			>
				<span class="font-display text-[0.7rem] font-semibold tracking-[0.14em] text-neutral-300 uppercase opacity-0 transition-opacity group-hover:opacity-100 group-aria-[current=true]:opacity-100">
					{chapter.label}
				</span>
				<span class="font-display text-xs font-semibold tabular-nums text-white">
					{String(index + 1).padStart(2, '0')}
				</span>
				<span class="block h-px w-4 bg-white/35 transition-all group-aria-[current=true]:w-8 group-aria-[current=true]:bg-primary"></span>
			</button>
		))
	}
</nav>

<div
	data-video-cursor
	data-play-label={copy.demo.play}
	data-pause-label={copy.demo.pause}
	data-go-label={copy.demo.go}
	data-scroll-label={copy.demo.scroll}
	class="pointer-events-none fixed top-0 left-0 z-[90] flex size-20 flex-col items-center justify-center rounded-full bg-primary text-white opacity-0 shadow-[0_12px_40px_rgba(107,72,233,0.45)] transition-[opacity,width,height,background-color,color,box-shadow] duration-300 will-change-transform data-[visible=true]:opacity-100 data-[mode=go]:size-11 data-[mode=go]:bg-white data-[mode=go]:text-ink data-[mode=go]:shadow-[0_8px_24px_rgba(0,0,0,0.35)] data-[mode=grab]:size-11 data-[mode=grabbing]:size-11 data-[mode=expand]:size-11 data-[mode=grab]:shadow-[0_8px_24px_rgba(107,72,233,0.4)] data-[mode=grabbing]:shadow-[0_8px_24px_rgba(107,72,233,0.4)] data-[mode=expand]:bg-white data-[mode=expand]:text-ink data-[mode=expand]:shadow-[0_8px_24px_rgba(0,0,0,0.35)] sm:size-24 sm:data-[mode=go]:size-12 sm:data-[mode=grab]:size-12 sm:data-[mode=grabbing]:size-12 sm:data-[mode=expand]:size-12"
	aria-hidden="true"
>
	<span data-video-cursor-label class="font-display text-xs font-semibold tracking-[0.18em] uppercase">{copy.demo.play}</span>
	<svg
		data-video-cursor-icon="pan"
		class="hidden size-7"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M8 12H4"></path>
		<path d="m6 9-3 3 3 3"></path>
		<path d="M16 12h4"></path>
		<path d="m18 9 3 3-3 3"></path>
	</svg>
	<svg
		data-video-cursor-icon="expand"
		class="hidden size-5"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="m15 15 6 6"></path>
		<path d="m15 9 6-6"></path>
		<path d="M21 16.2V21h-4.8"></path>
		<path d="M21 7.8V3h-4.8"></path>
		<path d="M3 16.2V21h4.8"></path>
		<path d="m3 21 6-6"></path>
		<path d="M3 7.8V3h4.8"></path>
		<path d="M3 3l6 6"></path>
	</svg>
	<svg
		data-video-cursor-icon="hand"
		class="hidden size-5"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M18 11V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2"></path>
		<path d="M14 10V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v2"></path>
		<path d="M10 10.5V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2v8"></path>
		<path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"></path>
	</svg>
	<svg
		data-video-cursor-icon="grab"
		class="hidden size-5"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M18 11.5V9a2 2 0 0 0-2-2a2 2 0 0 0-2 2v1.4"></path>
		<path d="M14 10V8a2 2 0 0 0-2-2a2 2 0 0 0-2 2v2"></path>
		<path d="M10 9.9V9a2 2 0 0 0-2-2a2 2 0 0 0-2 2v5"></path>
		<path d="M6 14a2 2 0 0 0-2-2a2 2 0 0 0-2 2"></path>
		<path d="M18 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"></path>
	</svg>
</div>

<main
	id="contenido"
	class="overflow-x-clip bg-ink-100 scroll-smooth [&_h1]:font-display [&_h2]:font-display [&_h3]:font-display [&_h4]:font-display"
>
	<section
		id="hero"
		data-hero-curtain
		data-chapter="hero"
		class="relative border-t-0 bg-ink"
	>
		<div data-hero-pin class="relative h-svh w-full overflow-hidden">
			<video
				data-demo-loop
				data-hero-video
				class="absolute inset-0 z-0 h-full w-full object-cover"
				src={demoVideo}
				poster={demoPoster}
				muted
				loop
				playsinline
				autoplay
				preload="auto"
			></video>

			<div
				data-curtain-top
				class="pointer-events-none absolute inset-x-0 top-0 z-[12] h-[18%] bg-ink [clip-path:polygon(0_0,100%_0,100%_70%,0_100%)] max-lg:hidden"
				aria-hidden="true"
			>
				<div class="absolute inset-y-0 left-0 w-1/3 bg-linear-to-r from-primary-900/40 to-transparent"></div>
			</div>
			<div
				data-curtain-bottom
				class="pointer-events-none absolute inset-x-0 bottom-0 z-[12] h-[18%] bg-ink [clip-path:polygon(0_30%,100%_0,100%_100%,0_100%)] max-lg:hidden"
				aria-hidden="true"
			>
				<div class="absolute inset-y-0 right-0 w-1/3 bg-linear-to-l from-feature-video/25 to-transparent"></div>
			</div>

			<div
				data-curtain-left
				class="absolute inset-y-0 left-0 z-[14] w-full bg-ink [clip-path:polygon(0_0,100%_0,100%_100%,0_100%)] lg:w-[56%] lg:[clip-path:polygon(0_0,100%_0,82%_100%,0_100%)]"
			>
				<div class="absolute inset-y-0 left-0 w-1/2 bg-linear-to-r from-primary-900/30 to-transparent" aria-hidden="true"></div>
				<div class="relative flex h-full items-center px-5 pt-28 pb-10 sm:px-8 lg:pr-10 lg:pl-10">
					<div class="flex w-full max-w-[34rem] flex-col">
						<div class="flex w-full flex-col gap-5 sm:gap-6">
							<p data-hero-exit="up" class="text-sm font-semibold tracking-[0.16em] text-primary-300 uppercase">{copy.hero.eyebrow}</p>
							<h1 data-hero-exit="up" class="text-3xl font-semibold tracking-tight text-balance text-white sm:text-4xl md:text-5xl lg:text-6xl">{copy.hero.title}</h1>
							<p data-hero-exit="left" class={body}>{copy.hero.subtitle}</p>
							<p data-hero-exit="left" class="text-base font-semibold text-pretty text-neutral-100">{copy.hero.support}</p>
							<div data-hero-exit="left" class="flex flex-wrap gap-3 pt-2">
								<Button href={signupUrl}>{copy.hero.cta}</Button>
								<Button href="#demo" variant="secondary">{copy.hero.secondaryCta}</Button>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div
				data-curtain-right
				class="pointer-events-none absolute inset-y-0 right-0 z-[14] hidden w-[20%] bg-ink/70 [clip-path:polygon(40%_0,100%_0,100%_100%,0_100%)] lg:block"
				aria-hidden="true"
			></div>

			<button
				type="button"
				data-video-hotspot
				data-hotspot-mode="scroll"
				class="absolute inset-0 z-[20] cursor-none border-0 bg-transparent max-lg:[clip-path:inset(0_0_0_100%)] lg:[clip-path:polygon(56%_8%,100%_0,100%_100%,48%_100%)]"
				aria-label={copy.demo.play}
			></button>

			<div
				data-origen-layer
				data-solid="false"
				class="group/origen absolute inset-0 z-[22] flex bg-ink opacity-0 pointer-events-none data-[solid=true]:pointer-events-auto"
				aria-hidden="true"
			>
				<div data-text-fill class="relative flex h-full w-full flex-col">
					<div
						data-origen-base
						class="grid h-full w-full grid-cols-1 text-white/20 group-data-[solid=true]/origen:text-white lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.15fr)]"
					>
						<div class="relative flex flex-col justify-between border-white/15 px-5 pt-28 pb-10 sm:px-8 lg:border-r lg:px-10 lg:pt-32 lg:pb-12">
							<p class="font-display text-xs font-semibold tracking-[0.2em] text-primary-300/40 uppercase group-data-[solid=true]/origen:text-primary-300">{origenChapterLabel}</p>
							<h2 class="max-w-[12ch] font-display text-[clamp(2.4rem,7vw,5.5rem)] leading-[0.95] font-semibold tracking-tight text-balance uppercase">
								{copy.origin.title}
							</h2>
							<p class="hidden text-xs font-semibold tracking-[0.16em] text-white/25 uppercase group-data-[solid=true]/origen:text-white/50 lg:block">{copy.footer.studio}</p>
						</div>
						<div class="relative flex flex-col justify-between gap-10 border-t border-white/15 px-5 pt-10 pb-10 sm:px-8 lg:border-t-0 lg:px-10 lg:pt-32 lg:pb-12">
							<p class="max-w-xl font-display text-xl leading-snug text-pretty text-primary-300/35 sm:text-2xl lg:text-3xl group-data-[solid=true]/origen:text-primary-300">{origenLead}</p>
							<div class="flex flex-col gap-8 border-t border-white/15 pt-8 lg:max-w-md lg:self-end lg:text-right">
								<div class="flex flex-col gap-4 text-sm text-pretty sm:text-base group-data-[solid=true]/origen:text-neutral-200">
									{origenRest.map((text) => (
										<p>{text}</p>
									))}
								</div>
								<p class="font-display text-lg font-semibold text-pretty sm:text-xl">{copy.origin.closing}</p>
							</div>
						</div>
					</div>
					<div
						data-text-fill-mask
						aria-hidden="true"
						class="pointer-events-none absolute inset-0 overflow-hidden text-white"
						style="clip-path: inset(0 0 100% 0)"
					>
						<div class="grid h-full w-full grid-cols-1 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.15fr)]">
							<div class="relative flex flex-col justify-between border-white/15 px-5 pt-28 pb-10 sm:px-8 lg:border-r lg:px-10 lg:pt-32 lg:pb-12">
								<p class="font-display text-xs font-semibold tracking-[0.2em] text-primary-300 uppercase">{origenChapterLabel}</p>
								<h2 class="max-w-[12ch] font-display text-[clamp(2.4rem,7vw,5.5rem)] leading-[0.95] font-semibold tracking-tight text-balance uppercase">
									{copy.origin.title}
								</h2>
								<p class="hidden text-xs font-semibold tracking-[0.16em] text-white/50 uppercase lg:block">{copy.footer.studio}</p>
							</div>
							<div class="relative flex flex-col justify-between gap-10 border-t border-white/15 px-5 pt-10 pb-10 sm:px-8 lg:border-t-0 lg:px-10 lg:pt-32 lg:pb-12">
								<p class="max-w-xl font-display text-xl leading-snug text-pretty text-primary-300 sm:text-2xl lg:text-3xl">{origenLead}</p>
								<div class="flex flex-col gap-8 border-t border-white/15 pt-8 lg:max-w-md lg:self-end lg:text-right">
									<div class="flex flex-col gap-4 text-sm text-pretty text-neutral-200 sm:text-base">
										{origenRest.map((text) => (
											<p>{text}</p>
										))}
									</div>
									<p class="font-display text-lg font-semibold text-pretty sm:text-xl">{copy.origin.closing}</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section
		id="demo"
		data-chapter="demo"
		data-snap-video
		aria-label={copy.demo.title}
		class="pointer-events-none relative h-px w-full overflow-hidden"
	></section>

	<!-- Anchor for nav; copy lives in the hero telón (data-origen-layer) only once -->
	<div id="origen" data-chapter="origen" class="pointer-events-none h-px w-full overflow-hidden" aria-hidden="true"></div>

	<section id="producto" data-chapter="producto" data-story class="relative border-t border-white/10 bg-ink">
		<div data-story-pin class="relative w-full max-lg:h-auto max-lg:overflow-visible lg:h-svh lg:overflow-hidden">
			<div data-parallax-bg class="pointer-events-none absolute inset-0 -z-10 max-lg:hidden" aria-hidden="true">
				<div class="absolute inset-y-0 left-0 w-1/4 bg-linear-to-r from-feature-image/15 to-transparent"></div>
				<div class="absolute inset-y-0 right-0 w-1/3 bg-linear-to-l from-primary-800/20 to-transparent"></div>
			</div>

			{/* Stage 1 — title + intro → right swaps to inconsistency visual */}
			<div data-story-stage class="max-lg:relative max-lg:border-b max-lg:border-white/10 lg:absolute lg:inset-0">
				<div class="grid w-full grid-cols-1 lg:h-full lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
					<div class="relative flex flex-col justify-between gap-8 border-white/15 px-5 pt-28 pb-10 sm:px-8 lg:border-r lg:px-10 lg:pt-32 lg:pb-12">
						<p class="font-display text-xs font-semibold tracking-[0.2em] text-primary-300 uppercase">
							{copy.consistency.eyebrow}
						</p>
						<h2 class="max-w-[16ch] font-display text-[clamp(1.85rem,4.6vw,3.75rem)] leading-[1.02] font-semibold tracking-tight text-balance text-white">
							{copy.consistency.title}
						</h2>
						<p class="hidden text-xs font-semibold tracking-[0.16em] text-white/45 uppercase lg:block">
							{copy.footer.studio}
						</p>
					</div>
					<div
						data-swap-col
						class="relative flex flex-col border-t border-white/15 px-5 py-10 sm:px-8 lg:h-full lg:border-t-0 lg:px-0 lg:py-0"
					>
						<div
							data-swap-copy
							class="relative z-10 flex flex-col justify-center gap-6 lg:h-full lg:gap-8 lg:px-10 lg:py-12"
						>
							<p class="max-w-xl font-display text-xl leading-snug text-pretty text-primary-300 sm:text-2xl lg:text-[1.75rem]">
								{copy.consistency.intro}
							</p>
							<p class="max-w-xl text-base text-pretty text-neutral-300 sm:text-lg">{copy.consistency.body}</p>
						</div>
						<div
							data-swap-media
							class="relative mt-8 flex items-center justify-center lg:absolute lg:inset-0 lg:mt-0 lg:px-8 lg:py-10"
						>
							<img
								src={asset('/problem/without-1.jpg')}
								alt={copy.consistency.inconsistencyAlt}
								width="1600"
								height="2000"
								class="h-auto w-full max-h-[min(58vh,28rem)] object-contain object-center lg:max-h-[min(70vh,34rem)]"
								loading="lazy"
								decoding="async"
							/>
						</div>
					</div>
				</div>
			</div>

			{/* Stage 2 — brand attributes bar */}
			<div data-story-stage class="max-lg:relative max-lg:border-b max-lg:border-white/10 lg:absolute lg:inset-0">
				<div class="flex w-full flex-col lg:h-full">
					<div class="flex flex-col justify-end gap-6 border-b border-white/15 px-5 pt-16 pb-8 sm:px-8 lg:flex-1 lg:px-10 lg:pt-32">
						<p class="font-display text-xs font-semibold tracking-[0.2em] text-primary-300 uppercase">
							{copy.consistency.pointsEyebrow}
						</p>
						<p class="max-w-3xl font-display text-2xl leading-snug text-pretty text-white sm:text-3xl lg:text-4xl">
							{copy.consistency.consequence}
						</p>
					</div>
					<div data-h-scroll class="touch-none select-none lg:touch-auto">
						<ul
							data-h-scroll-track
							class:list={[
								mobileCarousel,
								'border-white/15 px-5 sm:px-8 lg:grid-cols-4 lg:border-t lg:px-0',
							]}
						>
							{
								copy.consistency.points.map((point, index) => (
									<li
										class:list={[
											mobileSlide,
											'flex flex-col overflow-hidden border border-white/15 bg-ink-200 lg:rounded-none lg:border-0 lg:border-white/15 lg:bg-transparent',
											index > 0 && 'lg:border-l',
										]}
									>
										<div class="aspect-video overflow-hidden bg-ink-200">
											<img
												src={asset(point.image)}
												alt=""
												width="1200"
												height="675"
												class="h-full w-full object-cover"
												loading="lazy"
												decoding="async"
											/>
										</div>
										<div class="flex items-center justify-between gap-3 border-t border-white/15 px-4 py-4 sm:px-5">
											<p class="font-display text-sm font-semibold tracking-tight text-white sm:text-base">{point.label}</p>
											<span class="font-display text-xs font-semibold tabular-nums text-primary-300">
												{String(index + 1).padStart(2, '0')}
											</span>
										</div>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</div>

			{/* Stage 3 — secret / closing → right swaps to consistency visual */}
			<div data-story-stage class="max-lg:relative lg:absolute lg:inset-0">
				<div class="grid w-full grid-cols-1 lg:h-full lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
					<div class="relative flex flex-col justify-between gap-8 border-white/15 px-5 pt-16 pb-10 sm:px-8 lg:border-r lg:px-10 lg:pt-32 lg:pb-12">
						<p class="font-display text-xs font-semibold tracking-[0.2em] text-primary-300 uppercase">
							{copy.consistency.secretEyebrow}

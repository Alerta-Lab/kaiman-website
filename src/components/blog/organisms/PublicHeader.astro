---
import { Search } from 'lucide-react';
import { localeLabels, locales, type Locale } from '../../../i18n';
import { blogCategoryPath, blogIndexPath, blogSearchPath, swapBlogLocalePath } from '../../../lib/blog-paths';
import { listPublishedCategories, categoryDisplayName } from '../../../server/repositories/posts';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const home = blogIndexPath(locale);
const search = blogSearchPath(locale);
const categories = (await listPublishedCategories(locale)).slice(0, 6);
const copy =
	locale === 'en'
		? {
				search: 'Search articles',
				enter: 'Enter Kaiman',
				language: 'Language',
				mainNav: 'Main navigation',
				categoriesNav: 'Categories',
			}
		: {
				search: 'Buscar artículos',
				enter: 'Ingresa a Kaiman',
				language: 'Idioma',
				mainNav: 'Navegación principal',
				categoriesNav: 'Categorías',
			};
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-primary-200 bg-white">
	<nav
		aria-label={copy.mainNav}
		class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-gap-control border-b border-primary-200 px-5 lg:px-8"
	>
		<a href={home} class="inline-flex items-center gap-2.5 font-headline text-xl font-bold tracking-tight text-black">
			<img src="/brand/logo.png" alt="" width="32" height="32" class="size-8 rounded-lg bg-black object-contain p-1" />
			<span>
				Kaiman <span class="text-primary">Blog</span>
			</span>
		</a>
		<div class="flex items-center gap-3 sm:gap-4">
			<div class="flex items-center gap-3" role="group" aria-label={copy.language}>
				{
					locales.map((code) => {
						const href = swapBlogLocalePath(Astro.url.pathname, code);
						return (
							<a
								href={href}
								hreflang={code}
								class:list={[
									'inline-flex h-8 items-center text-sm font-bold text-primary-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
									code === locale ? 'underline underline-offset-4' : 'opacity-80 hover:opacity-100',
								]}
								aria-current={code === locale ? 'true' : undefined}
							>
								{localeLabels[code]}
							</a>
						);
					})
				}
			</div>
			<a
				href="https://app.kaimanstudio.ai/auth/login"
				class="inline-flex h-10 items-center rounded-lg bg-primary px-4 text-sm font-bold text-white hover:bg-primary-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
			>
				{copy.enter}
			</a>
		</div>
	</nav>
	<div class="bg-primary-100/50">
		<nav
			aria-label={copy.categoriesNav}
			class="mx-auto flex h-8 max-w-7xl items-center gap-gap-control px-5 lg:px-8"
		>
			<a
				aria-label={copy.search}
				href={search}
				class="inline-flex size-8 shrink-0 items-center justify-center rounded-md text-black hover:text-primary-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
			>
				<Search aria-hidden="true" size={16} />
			</a>
			<div class="flex min-w-0 flex-1 items-center gap-4 overflow-x-auto">
				{
					categories.map((category) => (
						<a
							href={blogCategoryPath(locale, category.slug)}
							class="shrink-0 text-sm font-bold text-primary-800 opacity-80 hover:opacity-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
						>
							{categoryDisplayName(category, locale)}
						</a>
					))
				}
			</div>
		</nav>
	</div>
</header>
{/* Spacer: main h-14 (56) + mini h-8 (32) = 88px */}
<div class="h-[5.5rem]" aria-hidden="true"></div>

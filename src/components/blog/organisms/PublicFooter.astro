---
import { Mail, MapPin, Phone } from 'lucide-react';
import { SocialIcon } from 'react-social-icons';
import { getLanding, type Locale } from '../../../i18n';
import { blogIndexPath } from '../../../lib/blog-paths';
import { localeUrl } from '../../../lib/locale-url';
import { alertaUrl, instagramUrl } from '../../../lib/plans';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getLanding(locale);
const year = new Date().getFullYear();
const home = localeUrl(locale);
const blog = blogIndexPath(locale);
---

<footer class="border-t border-primary-200 bg-primary-100">
	<div class="mx-auto grid max-w-7xl gap-gap-page px-5 py-16 lg:grid-cols-3 lg:px-8">
		<div class="flex flex-col gap-gap-control">
			<a href={home} class="inline-flex items-center gap-3 font-headline text-xl font-bold tracking-tight text-black">
				<img src="/logo.png" alt="" width="40" height="40" class="size-10 rounded-lg bg-black object-contain p-1" />
				<span>Kaiman</span>
			</a>
			<p class="inline-flex items-start gap-2 text-sm font-medium text-pretty text-black/75">
				<MapPin size={16} className="mt-0.5 shrink-0 text-primary-800" aria-hidden="true" />
				{copy.footer.address}
			</p>
			<a
				class="inline-flex min-h-11 items-center gap-2 text-sm font-bold text-primary-800 hover:text-primary"
				href={`mailto:${copy.footer.email}`}
			>
				<Mail size={16} aria-hidden="true" />
				{copy.footer.email}
			</a>
			<a class="inline-flex min-h-11 items-center gap-2 text-sm font-bold text-primary-800 hover:text-primary" href="tel:+15862024830">
				<Phone size={16} aria-hidden="true" />
				{copy.footer.phone}
			</a>
		</div>

		<nav class="flex flex-col gap-1" aria-label={copy.footer.contact}>
			<a
				class="inline-flex min-h-11 items-center rounded-lg px-2 text-sm font-bold text-black hover:bg-primary-200/70 hover:text-primary-800"
				href={blog}
			>
				Blog
			</a>
			<a
				class="inline-flex min-h-11 items-center rounded-lg px-2 text-sm font-bold text-black hover:bg-primary-200/70 hover:text-primary-800"
				href={home}
			>
				{locale === 'en' ? 'Home' : 'Inicio'}
			</a>
			<a
				class="inline-flex min-h-11 items-center rounded-lg px-2 text-sm font-bold text-black hover:bg-primary-200/70 hover:text-primary-800"
				href={localeUrl(locale, 'privacidad')}
			>
				{copy.footer.privacy}
			</a>
			<a
				class="inline-flex min-h-11 items-center rounded-lg px-2 text-sm font-bold text-black hover:bg-primary-200/70 hover:text-primary-800"
				href={localeUrl(locale, 'terminos')}
			>
				{copy.footer.terms}
			</a>
			<a
				class="inline-flex min-h-11 items-center rounded-lg px-2 text-sm font-bold text-black hover:bg-primary-200/70 hover:text-primary-800"
				href={alertaUrl}
			>
				{copy.footer.alerta}
			</a>
		</nav>

		<div class="flex flex-col gap-gap-control">
			<a
				class="inline-flex min-h-11 items-center gap-3 text-sm font-bold text-primary-800 hover:text-primary"
				href={instagramUrl}
			>
				<SocialIcon
					url={instagramUrl}
					as="span"
					bgColor="#6B48E9"
					fgColor="#ffffff"
					style={{ height: 32, width: 32 }}
					aria-label={copy.footer.instagram}
				/>
				{copy.footer.instagram}
			</a>
			<p class="text-sm font-medium text-black/65">
				© {year}. {copy.footer.rights}
			</p>
		</div>
	</div>
</footer>

---
import { Mail, MapPin, Phone } from 'lucide-react';
import { SocialIcon } from 'react-social-icons';
import { getLanding, type Locale } from '../../../i18n';
import { blogCategoryPath, blogIndexPath } from '../../../lib/blog-paths';
import { localeUrl } from '../../../lib/locale-url';
import { alertaUrl, instagramUrl, loginUrl, signupUrl } from '../../../lib/plans';
import { listPublishedCategories, categoryDisplayName } from '../../../server/repositories/posts';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getLanding(locale);
const year = new Date().getFullYear();
const home = localeUrl(locale);
const blog = blogIndexPath(locale);
const categories = (await listPublishedCategories(locale)).slice(0, 6);

const exploreLabel = locale === 'en' ? 'Explore' : 'Explorar';
const categoriesLabel = locale === 'en' ? 'Categories' : 'Categorías';
const accountLabel = locale === 'en' ? 'Account' : 'Cuenta';
const homeLabel = locale === 'en' ? 'Home' : 'Inicio';
const loginLabel = locale === 'en' ? 'Log in' : 'Iniciar sesión';
const signupLabel = locale === 'en' ? 'Sign up' : 'Registrarse';

const linkClass =
	'inline-flex min-h-11 items-center text-sm font-medium text-black/80 hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
const headingClass =
	'font-headline text-xs font-bold tracking-[0.14em] text-black uppercase';
---

<footer class="border-t border-primary-200 bg-white text-black">
	<div class="mx-auto max-w-7xl px-5 pt-12 pb-10 lg:px-8 lg:pt-16 lg:pb-12">
		<a href={home} class="inline-flex items-center gap-3 font-headline text-xl font-bold tracking-tight text-black">
			<img src="/logo.png" alt="" width="40" height="40" class="size-10 rounded-lg bg-black object-contain p-1" />
			<span>Kaiman</span>
		</a>

		<div class="mt-10 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:gap-x-10">
			<nav class="flex flex-col gap-1" aria-labelledby="footer-explore">
				<p id="footer-explore" class={headingClass}>{exploreLabel}</p>
				<a class={linkClass} href={home}>{homeLabel}</a>
				<a class={linkClass} href={blog}>Blog</a>
				<a class={linkClass} href={`${home}#brand-understanding`}>{copy.footer.brand}</a>
				<a class={linkClass} href={`${home}#planes`}>{copy.footer.plans}</a>
				<a class={linkClass} href={`${home}#preguntas`}>{copy.footer.faq}</a>
				<a class={linkClass} href={`${home}#playbooks`}>{copy.footer.playbooks}</a>
			</nav>

			{
				categories.length > 0 ? (
					<nav class="flex flex-col gap-1" aria-labelledby="footer-categories">
						<p id="footer-categories" class={headingClass}>
							{categoriesLabel}
						</p>
						{categories.map((category) => (
							<a class={linkClass} href={blogCategoryPath(locale, category.slug)}>
								{categoryDisplayName(category, locale)}
							</a>
						))}
						<a class={linkClass} href={blog}>{locale === 'en' ? 'View all articles' : 'Ver todos los artículos'}</a>
					</nav>
				) : (
					<nav class="flex flex-col gap-1" aria-labelledby="footer-resources">
						<p id="footer-resources" class={headingClass}>
							{copy.footer.resources}
						</p>
						<a class={linkClass} href={`${home}#demo`}>
							{copy.footer.how}
						</a>
						<a class={linkClass} href={blog}>
							Blog
						</a>
					</nav>
				)
			}

			<nav class="flex flex-col gap-1" aria-labelledby="footer-legal">
				<p id="footer-legal" class={headingClass}>{copy.footer.legal}</p>
				<a class={linkClass} href={localeUrl(locale, 'privacidad')}>{copy.footer.privacy}</a>
				<a class={linkClass} href={localeUrl(locale, 'terminos')}>{copy.footer.terms}</a>
				<a class={linkClass} href={alertaUrl} target="_blank" rel="noopener noreferrer">
					{copy.footer.alerta}
				</a>
			</nav>
		</div>

		<div class="mt-10 grid grid-cols-1 gap-8 border-t border-primary-200 pt-8 sm:grid-cols-2">
			<nav class="flex flex-col gap-1" aria-labelledby="footer-account">
				<p id="footer-account" class={headingClass}>{accountLabel}</p>
				<a class={`${linkClass} font-bold text-primary-800`} href={signupUrl}>
					{signupLabel}
				</a>
				<a class={linkClass} href={loginUrl}>
					{loginLabel}
				</a>
				<a class={linkClass} href={instagramUrl} target="_blank" rel="noopener noreferrer">
					<span class="inline-flex items-center gap-2">
						<SocialIcon
							url={instagramUrl}
							as="span"
							bgColor="#6B48E9"
							fgColor="#ffffff"
							style={{ height: 20, width: 20 }}
							aria-label={copy.footer.instagram}
						/>
						{copy.footer.instagram}
					</span>
				</a>
			</nav>
			<div class="flex flex-col gap-1" aria-labelledby="footer-contact">
				<p id="footer-contact" class={headingClass}>{copy.footer.contact}</p>
				<p class="inline-flex min-h-11 items-start gap-2 text-sm font-medium text-pretty text-black/80">
					<MapPin size={16} className="mt-0.5 shrink-0 text-primary-800" aria-hidden="true" />
					<span>{copy.footer.address}</span>
				</p>
				<a class={`${linkClass} gap-2`} href={`mailto:${copy.footer.email}`}>
					<Mail size={16} aria-hidden="true" />
					{copy.footer.email}
				</a>
				<a class={`${linkClass} gap-2`} href="tel:+15862024830">
					<Phone size={16} aria-hidden="true" />
					{copy.footer.phone}
				</a>
			</div>
		</div>
	</div>

	<div class="border-t border-primary-200">
		<div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-5 text-sm text-black/65 lg:px-8">
			<p class="font-medium">
				© {year}. {copy.footer.rights}
			</p>
			<div class="flex items-center gap-5">
				<a class="font-medium hover:text-primary" href={alertaUrl} target="_blank" rel="noopener noreferrer">
					{copy.footer.alerta}
				</a>
				<a class="font-medium hover:text-primary" href={blog}>
					Blog
				</a>
			</div>
		</div>
	</div>
</footer>

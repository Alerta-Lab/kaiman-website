---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ArrowUp, Mail, MapPin, Phone } from 'lucide-react';
import { SocialIcon } from 'react-social-icons';
import { getLanding, type Locale } from '../../i18n';
import { blogIndexPath } from '../../lib/blog-paths';
import { alertaUrl, instagramUrl, signupUrl } from '../../lib/plans';
import Button from '../ui/Button.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getLanding(locale);
const home = getRelativeLocaleUrl(locale, '/');
const year = new Date().getFullYear();

const productLinks = [
	{ href: `${home}#origen`, label: copy.footer.how },
	{ href: `${home}#brand-understanding`, label: copy.footer.brand },
	{ href: `${home}#planes`, label: copy.footer.plans },
	{ href: `${home}#preguntas`, label: copy.footer.faq },
];

const resourceLinks = [
	{ href: `${home}#playbooks`, label: copy.footer.playbooks },
	{ href: blogIndexPath(locale), label: copy.footer.help },
];

const legalLinks = [
	{ href: getRelativeLocaleUrl(locale, '/terminos'), label: copy.footer.terms },
	{ href: getRelativeLocaleUrl(locale, '/privacidad'), label: copy.footer.privacy },
];
---

<footer data-site-footer class="relative min-h-svh border-t border-white/10 bg-ink-100">
	<div class="mx-auto flex min-h-svh w-full max-w-content flex-col justify-between gap-16 px-4 py-16 sm:px-6 sm:py-24">
		<div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
			<div class="max-w-3xl flex flex-col gap-6">
				<p class="text-sm font-semibold tracking-[0.14em] text-primary-300 uppercase">{copy.footer.studio}</p>
				<h2 class="font-display text-4xl font-semibold tracking-tight text-balance text-white sm:text-5xl lg:text-6xl">
					{copy.footer.lead}
				</h2>
			</div>
			<div class="flex flex-wrap items-center gap-3">
				<Button href={signupUrl}>{copy.footer.cta}</Button>
				<div data-back-top-dock class="relative size-11 shrink-0">
					<a
						href="#hero"
						data-back-top
						data-docked="false"
						class="inline-flex size-11 items-center justify-center rounded-full bg-primary text-white shadow-[0_12px_32px_rgba(107,72,233,0.35)] transition-[opacity,background-color] duration-300 hover:bg-primary-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary data-[docked=false]:fixed data-[docked=false]:right-5 data-[docked=false]:bottom-5 data-[docked=false]:z-50 data-[docked=false]:opacity-0 data-[docked=false]:pointer-events-none data-[docked=false]:data-[ready=true]:opacity-100 data-[docked=false]:data-[ready=true]:pointer-events-auto data-[docked=true]:absolute data-[docked=true]:inset-0 sm:data-[docked=false]:right-6 sm:data-[docked=false]:bottom-6"
						aria-label={copy.footer.backTop}
					>
						<ArrowUp size={18} aria-hidden="true" />
					</a>
				</div>
			</div>
		</div>

		<div class="grid gap-12 border-t border-white/10 pt-12 lg:grid-cols-4">
			<div class="flex flex-col gap-3">
				<p class="inline-flex items-start gap-2 text-sm text-pretty text-neutral-300">
					<MapPin size={16} className="mt-0.5 shrink-0" aria-hidden="true" />
					{copy.footer.address}
				</p>
				<a class="inline-flex items-center gap-2 text-sm text-neutral-300 hover:underline hover:underline-offset-4" href={`mailto:${copy.footer.email}`}>
					<Mail size={16} aria-hidden="true" />
					{copy.footer.email}
				</a>
				<a class="inline-flex items-center gap-2 text-sm text-neutral-300 hover:underline hover:underline-offset-4" href="tel:+15862024830">
					<Phone size={16} aria-hidden="true" />
					{copy.footer.phone}
				</a>
				<a class="mt-2 inline-flex items-center gap-3 text-sm font-semibold text-neutral-300 hover:underline hover:underline-offset-4" href={instagramUrl}>
					<SocialIcon
						url={instagramUrl}
						as="span"
						bgColor="#6B48E9"
						fgColor="#ffffff"
						style={{ height: 32, width: 32 }}
						aria-label={copy.footer.instagram}
					/>
					{copy.footer.instagram}
				</a>
			</div>

			<nav class="flex flex-col gap-2" aria-label={copy.footer.product}>
				<p class="text-sm font-semibold text-white">{copy.footer.product}</p>
				{productLinks.map((link) => (
					<a class="w-fit text-sm text-neutral-300 hover:underline hover:underline-offset-4" href={link.href}>
						{link.label}
					</a>
				))}
			</nav>

			<nav class="flex flex-col gap-2" aria-label={copy.footer.resources}>
				<p class="text-sm font-semibold text-white">{copy.footer.resources}</p>
				{resourceLinks.map((link) => (
					<a class="w-fit text-sm text-neutral-300 hover:underline hover:underline-offset-4" href={link.href}>
						{link.label}
					</a>
				))}
				<a class="w-fit text-sm text-neutral-300 hover:underline hover:underline-offset-4" href={alertaUrl}>{copy.footer.alerta}</a>
			</nav>

			<nav class="flex flex-col gap-2" aria-label={copy.footer.legal}>
				<p class="text-sm font-semibold text-white">{copy.footer.legal}</p>
				{legalLinks.map((link) => (
					<a class="w-fit text-sm text-neutral-300 hover:underline hover:underline-offset-4" href={link.href}>
						{link.label}
					</a>
				))}
				<p class="mt-4 text-sm text-neutral-400">
					© {year} {copy.footer.studio}. {copy.footer.rights}
				</p>
			</nav>
		</div>
	</div>
</footer>

<script>
	const footer = document.querySelector('[data-site-footer]');
	const button = document.querySelector('[data-back-top]');
	if (!(footer instanceof HTMLElement) || !(button instanceof HTMLElement)) {
		// no-op
	} else {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let docked = false;

		const setReady = () => {
			button.dataset.ready = window.scrollY > 240 ? 'true' : 'false';
		};

		const flipTo = (nextDocked: boolean) => {
			if (nextDocked === docked) return;
			const first = button.getBoundingClientRect();
			docked = nextDocked;
			button.dataset.docked = nextDocked ? 'true' : 'false';
			const last = button.getBoundingClientRect();
			const dx = first.left - last.left;
			const dy = first.top - last.top;
			if (reduce || (Math.abs(dx) < 1 && Math.abs(dy) < 1)) return;
			button.animate(
				[{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'translate(0, 0)' }],
				{ duration: 480, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
			);
		};

		const io = new IntersectionObserver(
			(entries) => {
				const entry = entries[0];
				if (!entry) return;
				flipTo(entry.isIntersecting);
			},
			{ root: null, threshold: 0, rootMargin: '0px 0px -8% 0px' },
		);
		io.observe(footer);

		setReady();
		window.addEventListener('scroll', setReady, { passive: true });
	}
</script>

---
interface Props {
	class?: string;
	as?: 'div' | 'article' | 'li';
}

const { class: className, as: Tag = 'div' } = Astro.props;
---

<Tag
	class:list={[
		'rounded-2xl bg-ink-200 p-6 transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1',
		className,
	]}
>
	<slot />
</Tag>

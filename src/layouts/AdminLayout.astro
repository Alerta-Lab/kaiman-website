---
import { BarChart3, FileText, FolderTree, Image, LayoutDashboard, LogOut, Menu, Tags, X } from 'lucide-react';
import Kbd from '../components/ui/atoms/Kbd.astro';
import { getAdminLocale } from '../server/admin-locale';
import BlogLayout from './BlogLayout.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
const adminLocale = getAdminLocale(Astro.cookies);
const links = [
	{ href: '/admin', label: 'Resumen', icon: LayoutDashboard, key: 'R' },
	{ href: '/admin/posts', label: 'Artículos', icon: FileText, key: 'A' },
	{ href: '/admin/categorias', label: 'Categorías', icon: FolderTree, key: 'C' },
	{ href: '/admin/tags', label: 'Etiquetas', icon: Tags, key: 'E' },
	{ href: '/admin/media', label: 'Imágenes', icon: Image, key: 'I' },
	{ href: '/admin/analytics', label: 'Analítica', icon: BarChart3, key: 'L' },
] as const;

const shortcutMap = Object.fromEntries(links.map((link) => [link.key.toLowerCase(), link.href]));
const redirectPath = Astro.url.pathname + Astro.url.search;
---

<BlogLayout title={`${title} — Admin Kaiman`} description="Panel de administración de Kaiman Blog." noindex>
	<div class="min-h-screen bg-primary-100">
		<button
			type="button"
			id="admin-nav-overlay"
			class="fixed inset-0 z-30 hidden bg-black/50 lg:hidden"
			aria-label="Cerrar menú"
			hidden
		></button>

		<aside
			id="admin-sidebar"
			class="fixed inset-y-0 left-0 z-40 flex h-dvh w-[min(100%,15.5rem)] -translate-x-full flex-col overflow-y-auto border-r border-black-stroke bg-black-panel p-5 text-white transition-transform duration-200 ease-out lg:translate-x-0"
			aria-label="Navegación del panel"
		>
			<div class="flex items-center justify-between gap-2">
				<a href="/admin" class="inline-flex items-center gap-3 font-headline text-xl font-bold tracking-tight">
					<img src="/logo.png" alt="" width="36" height="36" class="size-9 rounded-md bg-black object-contain p-0.5" />
					<span>Kaiman <span class="text-primary-300">Admin</span></span>
				</a>
				<button
					type="button"
					id="admin-nav-close"
					class="inline-flex size-11 items-center justify-center rounded-lg text-white/80 hover:bg-black-capsule lg:hidden"
					aria-label="Cerrar menú"
				>
					<X aria-hidden="true" size={20} />
				</button>
			</div>
			<form action="/api/admin/locale" method="post" class="mt-6" aria-label="Idioma de contenido">
				<input type="hidden" name="redirect" value={redirectPath} />
				<p class="mb-2 px-1 text-xs font-bold uppercase tracking-wide text-white/55">Idioma</p>
				<div class="grid h-8 grid-cols-2 gap-1 rounded-lg bg-black-capsule p-0.5">
					<button
						type="submit"
						name="locale"
						value="es"
						aria-pressed={adminLocale === 'es'}
						class="h-full rounded-md px-3 text-xs font-bold text-white/80 hover:bg-black-panel aria-[pressed=true]:bg-primary aria-[pressed=true]:text-white"
					>
						ES
					</button>
					<button
						type="submit"
						name="locale"
						value="en"
						aria-pressed={adminLocale === 'en'}
						class="h-full rounded-md px-3 text-xs font-bold text-white/80 hover:bg-black-panel aria-[pressed=true]:bg-primary aria-[pressed=true]:text-white"
					>
						EN
					</button>
				</div>
			</form>
			<nav aria-label="Panel administrativo" class="mt-6 flex flex-col gap-2">
				{
					links.map(({ href, label, icon: Icon, key }) => (
						<a
							href={href}
							aria-current={
								Astro.url.pathname === href || (href !== '/admin' && Astro.url.pathname.startsWith(href))
									? 'page'
									: undefined
							}
							class="flex min-h-11 items-center gap-3 rounded-lg px-3 font-bold text-white/90 hover:bg-black-capsule aria-[current=page]:bg-primary aria-[current=page]:text-white"
						>
							<Icon aria-hidden="true" size={19} />
							<span class="flex-1">{label}</span>
							<Kbd tone="onPrimary" label={`Atajo ${key}`} class="ml-auto opacity-90">
								{key}
							</Kbd>
						</a>
					))
				}
			</nav>
			<form action="/api/auth/logout" method="post" class="mt-auto pt-8">
				<button class="flex min-h-11 w-full items-center gap-3 rounded-lg px-3 font-bold text-white/80 hover:bg-black-capsule hover:text-white">
					<LogOut aria-hidden="true" size={19} /> Salir
				</button>
			</form>
		</aside>

		<main id="contenido" class="min-w-0 p-5 lg:ml-[15.5rem] lg:p-10">
			<header class="mb-gap-page flex flex-wrap items-center gap-3 border-b border-primary-200 pb-gap-block sm:gap-4">
				<button
					type="button"
					id="admin-nav-open"
					class="inline-flex size-11 shrink-0 items-center justify-center rounded-lg border border-black/10 bg-white text-black hover:bg-primary-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary lg:hidden"
					aria-controls="admin-sidebar"
					aria-expanded="false"
					aria-label="Abrir menú"
				>
					<Menu aria-hidden="true" size={20} />
				</button>
				<h1 class="min-w-0 flex-1 font-headline text-3xl font-bold tracking-tight text-black sm:text-4xl">{title}</h1>
				{
					Astro.slots.has('actions') ? (
						<div class="flex w-full flex-wrap items-center justify-end gap-3 sm:ml-auto sm:w-auto">
							<slot name="actions" />
						</div>
					) : null
				}
			</header>
			<slot />
		</main>
	</div>
	<script define:vars={{ shortcutMap }}>
		document.addEventListener('keydown', (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;
			if (['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName) || target.isContentEditable) return;
			if (event.metaKey || event.ctrlKey || event.altKey) return;

			const key = event.key.toLowerCase();
			if (key === 'n') {
				event.preventDefault();
				location.href = '/admin/posts/nuevo';
				return;
			}

			const href = shortcutMap[key];
			if (href) {
				event.preventDefault();
				location.href = href;
			}
		});

		const sidebar = document.getElementById('admin-sidebar');
		const overlay = document.getElementById('admin-nav-overlay');
		const openBtn = document.getElementById('admin-nav-open');
		const closeBtn = document.getElementById('admin-nav-close');

		const setNavOpen = (open) => {
			if (!sidebar || !overlay || !openBtn) return;
			sidebar.classList.toggle('-translate-x-full', !open);
			sidebar.classList.toggle('translate-x-0', open);
			overlay.hidden = !open;
			overlay.classList.toggle('hidden', !open);
			openBtn.setAttribute('aria-expanded', String(open));
			document.body.classList.toggle('overflow-hidden', open);
		};

		openBtn?.addEventListener('click', () => setNavOpen(true));
		closeBtn?.addEventListener('click', () => setNavOpen(false));
		overlay?.addEventListener('click', () => setNavOpen(false));

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setNavOpen(false);
		});

		window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
			if (event.matches) setNavOpen(false);
		});
	</script>
</BlogLayout>
